      "id": 1,
      "difficulte": "facile",
      "notion": "denombrer",
      "enonce": "Léo dessine 1 dizaine de points et encore 2 points. Combien de points a-t-il dessinés ?",
      "corrige": [
        "Une dizaine, c'est 10 points.",
        "10 et 2 points, cela fait 12."
      ],
      "reponse": "Léo a dessiné 12 points."
    },
    {
      "id": 2,
      "difficulte": "facile",
      "notion": "ecrire-en-chiffres",
      "enonce": "Écris en chiffres le nombre « dix-sept ».",
      "corrige": [
        "Dix-sept, c'est 10 et 7.",
        "On l'écrit 17."
      ],
      "reponse": "Dix-sept s'écrit 17."
    },
    {
      "id": 3,
      "difficulte": "facile",
      "notion": "nombre-suivant",
      "enonce": "Quel est le nombre juste après 19 ?",
      "corrige": [
        "Juste après, on ajoute 1 : 19 + 1.",
        "19 + 1 = 20."
      ],
      "reponse": "Après 19 vient 20."
    },
    {
      "id": 4,
      "difficulte": "moyen",
      "notion": "suite-de-nombres",
      "enonce": "Complète la suite : 11, 12, ..., 14.",
      "corrige": [
        "On compte de 1 en 1 : 11, 12, puis...",
        "Après 12 vient 13, et 13 est bien juste avant 14."
      ],
      "reponse": "Le nombre manquant est 13."
    },
    {
      "id": 5,
      "difficulte": "moyen",
      "notion": "ecrire-en-lettres",
      "enonce": "Écris en lettres le nombre 15.",
      "corrige": [
        "15, c'est 10 et 5.",
        "On l'écrit « quinze »."
      ],
      "reponse": "15 s'écrit « quinze »."
    },
    {
      "id": 6,
      "difficulte": "difficile",
      "notion": "compter-de-2-en-2",
      "enonce": "Compte de 2 en 2 en partant de 10 jusqu'à 20. Écris tous les nombres.",
      "corrige": [
        "On ajoute 2 à chaque fois : 10, 12, 14...",
        "On continue : 14, 16, 18, 20."
      ],
      "reponse": "10, 12, 14, 16, 18, 20."
    },
    {
      "id": 7,
      "difficulte": "decouverte",
      "notion": "ecrire-en-chiffres",
      "enonce": "Écris en chiffres le nombre « douze ».",

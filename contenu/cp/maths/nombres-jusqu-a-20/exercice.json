      "id": 8,
      "difficulte": "application",
      "notion": "nombre-precedent",
      "enonce": "Quel est le nombre juste avant 12 ?",
      "corrige": [
        "Juste avant, on enlève 1.",
        "12 - 1 = 11."
      ],
      "reponse": "Avant 12 vient 11."
    },

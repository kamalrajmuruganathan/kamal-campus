    {
      "recto": "Zeus = quel dieu romain ?",
      "verso": "Jupiter, roi des dieux et du ciel."
    },
    {
      "recto": "Héra = quelle déesse romaine ?",
      "verso": "Junon, déesse du mariage, épouse de Jupiter."
    },
    {
      "recto": "Poséidon = ?",
      "verso": "Neptune, dieu de la mer."
    },
    {
      "recto": "Athéna = ?",
      "verso": "Minerve, déesse de la sagesse."
    },
    {
      "recto": "Aphrodite = ?",
      "verso": "Vénus, déesse de l'amour et de la beauté."
    },
    {
      "recto": "Arès = ?",
      "verso": "Mars, dieu de la guerre."
    },
    {
      "recto": "Hermès, Artémis, Héphaïstos = ?",
      "verso": "Mercure (messager), Diane (chasse), Vulcain (forge)."
    },
    {
      "recto": "Hadès, Déméter, Dionysos = ?",
      "verso": "Pluton (Enfers), Cérès (moissons), Bacchus (vin)."
    },
    {
      "recto": "Qui accomplit les douze travaux ?",
      "verso": "Héraclès (Hercule)."
    },
    {
      "recto": "Qui tue le Minotaure, aidé du fil d'Ariane ?",
      "verso": "Thésée."
    },
    {
      "recto": "Qui tranche la tête de Méduse ?",
      "verso": "Persée."
    },
    {
      "recto": "Héros de l'Odyssée et de l'Iliade (grec) ?",
      "verso": "Ulysse (Odyssée) et Achille (Iliade)."

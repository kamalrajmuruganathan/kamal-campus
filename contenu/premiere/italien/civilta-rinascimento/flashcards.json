    {
      "recto": "Que signifie « Rinascimento » ?",
      "verso": "Renaissance : la redécouverte de l'art et de la pensée antiques."
    },
    {
      "recto": "À quels siècles situe-t-on le Rinascimento ?",
      "verso": "Aux XVe et XVIe siècles."
    },
    {
      "recto": "Où naît le Rinascimento ?",
      "verso": "A Firenze (Florence)."
    },
    {
      "recto": "Qu'est-ce que l'Umanesimo ?",
      "verso": "Un courant qui place l'homme et l'Antiquité classique au centre."
    },
    {
      "recto": "Quelle famille protège les artistes à Florence ?",
      "verso": "I Medici (banquiers, grands mécènes)."
    },
    {
      "recto": "Surnom de Lorenzo de' Medici ?",
      "verso": "Il Magnifico."
    },
    {
      "recto": "Qu'est-ce que le mecenatismo ?",
      "verso": "Le mécénat : financer et protéger les artistes."
    },
    {
      "recto": "Qui a construit la coupole du Duomo de Florence ?",
      "verso": "Filippo Brunelleschi."
    },
    {
      "recto": "Autre nom du Duomo de Florence ?",
      "verso": "Santa Maria del Fiore."
    },
    {
      "recto": "Qu'est-ce que la prospettiva ?",
      "verso": "La perspective : l'illusion de profondeur dans une image."
    },
    {
      "recto": "Qui a écrit « Il Principe » ?",
      "verso": "Niccolò Machiavelli (traité politique)."
    },
    {
      "recto": "Que désigne « il Quattrocento » ?",
      "verso": "Le XVe siècle (les années 1400)."
    }
  ]
}
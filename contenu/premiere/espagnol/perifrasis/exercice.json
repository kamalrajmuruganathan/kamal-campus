      "difficulte": "decouverte",
      "notion": "ir-a",
      "enonce": "Exprime le futur proche : (yo, estudiar) esta noche.",
      "corrige": [
        "« ir a » + infinitif.",
        "voy a estudiar."
      ],
      "reponse": "Voy a estudiar esta noche."
    },
    {
      "id": 2,
      "difficulte": "decouverte",
      "notion": "acabar-de",
      "enonce": "Exprime le passé récent : (nosotros, terminar) el examen.",
      "corrige": [
        "« acabar de » + infinitif.",
        "acabamos de terminar."
      ],
      "reponse": "Acabamos de terminar el examen."
    },
    {
      "id": 3,
      "difficulte": "application",

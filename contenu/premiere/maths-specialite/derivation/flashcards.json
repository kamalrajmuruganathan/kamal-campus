  "relu_par": null,
  "cartes": [
    { "recto": "Quelle est l'expression du **taux de variation** de $f$ entre $a$ et $b$ ?", "verso": "$\\tau = \\dfrac{f(b)-f(a)}{b-a}$, coefficient directeur de la sécante." },
    { "recto": "Définition du **nombre dérivé** $f'(a)$ ?", "verso": "$f'(a) = \\lim\\limits_{h\\to 0} \\dfrac{f(a+h)-f(a)}{h}$" },
    { "recto": "Que représente géométriquement $f'(a)$ ?", "verso": "La **pente de la tangente** à la courbe au point d'abscisse $a$." },
    { "recto": "Équation de la **tangente** à $\\mathcal{C}_f$ au point d'abscisse $a$ ?", "verso": "$y = f'(a)(x-a) + f(a)$" },
    { "recto": "Formule de l'**approximation affine** de $f$ au voisinage de $a$ ?", "verso": "$f(a+h) \\approx f(a) + f'(a)\\,h$ pour $h$ proche de $0$." },
    { "recto": "Dérivée de $x^n$ ($n$ entier $\\geqslant 1$) ?", "verso": "$n\\,x^{n-1}$" },
    { "recto": "Dérivée de $\\dfrac{1}{x}$ et de $\\sqrt{x}$ ?", "verso": "$\\left(\\dfrac{1}{x}\\right)' = -\\dfrac{1}{x^2}$ et $\\left(\\sqrt{x}\\right)' = \\dfrac{1}{2\\sqrt{x}}$." },
    { "recto": "Dérivée d'un **produit** $uv$ ?", "verso": "$(uv)' = u'v + uv'$" },
    { "recto": "Dérivée d'un **quotient** $\\dfrac{u}{v}$ ?", "verso": "$\\left(\\dfrac{u}{v}\\right)' = \\dfrac{u'v - uv'}{v^2}$" },
    { "recto": "Dérivée de $x \\mapsto f(ax+b)$ ?", "verso": "$x \\mapsto a\\,f'(ax+b)$ — ne pas oublier le facteur $a$." },
    { "recto": "La fonction $\\sqrt{x}$ est-elle dérivable en $0$ ?", "verso": "Non : elle y est définie mais **pas dérivable** (tangente verticale)." },
    { "recto": "A-t-on $(uv)' = u'v'$ ?", "verso": "Non, c'est faux. La bonne formule est $u'v + uv'$." }
  ]
}

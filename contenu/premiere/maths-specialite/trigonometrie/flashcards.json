  "cartes": [
    { "recto": "Qu'est-ce que le **cercle trigonométrique** ?", "verso": "Le cercle de centre $\\mathrm{O}$ et de rayon $1$, orienté dans le sens inverse des aiguilles d'une montre." },
    { "recto": "Combien vaut $\\pi$ radians en degrés, et la formule de conversion ?", "verso": "$\\pi$ rad $= 180°$ ; $\\text{radians} = \\text{degrés} \\times \\dfrac{\\pi}{180}$." },
    { "recto": "Coordonnées du point $\\mathrm{M}$ associé au réel $x$ sur le cercle ?", "verso": "$\\mathrm{M}(\\cos x\\,;\\sin x)$ : le cosinus est l'abscisse, le sinus l'ordonnée." },
    { "recto": "Relation fondamentale de la trigonométrie ?", "verso": "$\\cos^2 x + \\sin^2 x = 1$" },
    { "recto": "Encadrement de $\\cos x$ et $\\sin x$ ?", "verso": "$-1 \\leqslant \\cos x \\leqslant 1$ et $-1 \\leqslant \\sin x \\leqslant 1$." },
    { "recto": "Que valent $\\cos$ et $\\sin$ en $\\dfrac{\\pi}{6}$, $\\dfrac{\\pi}{4}$, $\\dfrac{\\pi}{3}$ ?", "verso": "$\\cos : \\dfrac{\\sqrt3}{2},\\ \\dfrac{\\sqrt2}{2},\\ \\dfrac12$ ; $\\sin : \\dfrac12,\\ \\dfrac{\\sqrt2}{2},\\ \\dfrac{\\sqrt3}{2}$." },
    { "recto": "Propriété de **périodicité** de $\\cos$ et $\\sin$ ?", "verso": "$\\cos(x+2k\\pi) = \\cos x$ et $\\sin(x+2k\\pi) = \\sin x$ ($k \\in \\mathbb{Z}$)." },
    { "recto": "$\\cos$ et $\\sin$ sont-elles paires ou impaires ?", "verso": "$\\cos$ est **paire** ($\\cos(-x)=\\cos x$), $\\sin$ est **impaire** ($\\sin(-x)=-\\sin x$)." },
    { "recto": "Que valent $\\cos(\\pi - x)$ et $\\sin(\\pi - x)$ ?", "verso": "$\\cos(\\pi-x) = -\\cos x$ et $\\sin(\\pi-x) = \\sin x$." },
    { "recto": "Que valent $\\cos\\left(\\dfrac{\\pi}{2}-x\\right)$ et $\\sin\\left(\\dfrac{\\pi}{2}-x\\right)$ ?", "verso": "$\\cos\\left(\\dfrac{\\pi}{2}-x\\right) = \\sin x$ et $\\sin\\left(\\dfrac{\\pi}{2}-x\\right) = \\cos x$." },
    { "recto": "L'équation $\\cos x = 2$ a-t-elle une solution ?", "verso": "Non : le cosinus reste toujours entre $-1$ et $1$." },
    { "recto": "En quelle unité travaille-t-on en trigonométrie de première ?", "verso": "En **radians** — vérifier le mode de la calculatrice." }
  ]
}

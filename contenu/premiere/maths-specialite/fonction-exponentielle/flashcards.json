  "cartes": [
    { "recto": "Quelle propriété **définit** la fonction exponentielle ?", "verso": "L'unique fonction dérivable sur $\\mathbb{R}$ telle que $f' = f$ et $f(0) = 1$." },
    { "recto": "Que vaut le nombre $\\mathrm{e}$ ?", "verso": "$\\mathrm{e} = \\exp(1) \\approx 2{,}718$." },
    { "recto": "Relation transformant les **sommes en produits** ?", "verso": "$\\mathrm{e}^{a+b} = \\mathrm{e}^a \\times \\mathrm{e}^b$" },
    { "recto": "Simplifier $\\dfrac{\\mathrm{e}^a}{\\mathrm{e}^b}$ et $\\mathrm{e}^{-a}$ ?", "verso": "$\\dfrac{\\mathrm{e}^a}{\\mathrm{e}^b} = \\mathrm{e}^{a-b}$ et $\\mathrm{e}^{-a} = \\dfrac{1}{\\mathrm{e}^a}$." },
    { "recto": "Quel est le **signe** de $\\mathrm{e}^x$ ?", "verso": "$\\mathrm{e}^x > 0$ pour tout réel $x$, toujours." },
    { "recto": "Sens de variation de la fonction exponentielle ?", "verso": "Strictement **croissante** sur $\\mathbb{R}$ (car $\\exp' = \\exp > 0$)." },
    { "recto": "Résoudre $\\mathrm{e}^a = \\mathrm{e}^b$ et $\\mathrm{e}^a < \\mathrm{e}^b$ ?", "verso": "$\\mathrm{e}^a = \\mathrm{e}^b \\iff a = b$ ; $\\mathrm{e}^a < \\mathrm{e}^b \\iff a < b$." },
    { "recto": "Dérivée de $\\mathrm{e}^{ax+b}$ ?", "verso": "$\\left(\\mathrm{e}^{ax+b}\\right)' = a\\,\\mathrm{e}^{ax+b}$" },
    { "recto": "Dérivée de $\\mathrm{e}^{u}$ ?", "verso": "$\\left(\\mathrm{e}^{u}\\right)' = u'\\,\\mathrm{e}^{u}$" },
    { "recto": "Combien de solutions a l'équation $\\mathrm{e}^x = -3$ ?", "verso": "Aucune : l'exponentielle n'est jamais négative ni nulle." },
    { "recto": "Équation de la tangente à la courbe de $\\exp$ en $0$ ?", "verso": "$y = x + 1$ (car $\\exp(0)=1$ et $\\exp'(0)=1$)." },
    { "recto": "La fonction $x \\mapsto \\mathrm{e}^{-x}$ est-elle croissante ?", "verso": "Non, décroissante : sa dérivée $-\\mathrm{e}^{-x}$ est négative." }
  ]

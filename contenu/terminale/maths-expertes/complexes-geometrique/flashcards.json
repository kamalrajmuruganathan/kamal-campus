  "cartes": [
    { "recto": "Affixe d'un vecteur $\\overrightarrow{AB}$ ?", "verso": "$z_{\\overrightarrow{AB}} = z_B - z_A$." },
    { "recto": "Définition du **module** $|z|$ de $z=a+ib$ ?", "verso": "$|z| = \\sqrt{a^2+b^2}$ (c'est la distance $OM$)." },
    { "recto": "Lien entre module et conjugué ?", "verso": "$|z|^2 = z\\,\\overline{z}$." },
    { "recto": "Distance $AB$ à l'aide des affixes ?", "verso": "$AB = |z_B - z_A|$." },
    { "recto": "Module d'un produit et d'une puissance ?", "verso": "$|zz'| = |z|\\,|z'|$ et $|z^n| = |z|^n$." },
    { "recto": "Forme **trigonométrique** de $z$ (module $r$, argument $\\theta$) ?", "verso": "$z = r(\\cos\\theta + i\\sin\\theta)$, avec $r=|z|>0$ et $\\theta = \\arg(z)$." },
    { "recto": "Propriété de l'argument d'un produit ?", "verso": "$\\arg(zz') = \\arg z + \\arg z'$ (modulo $2\\pi$) : multiplier ajoute les angles." },
    { "recto": "Que vaut $\\mathrm{e}^{i\\theta}$ (forme exponentielle) ?", "verso": "$\\mathrm{e}^{i\\theta} = \\cos\\theta + i\\sin\\theta$ ; tout $z\\neq 0$ s'écrit $z = r\\,\\mathrm{e}^{i\\theta}$." },
    { "recto": "**Formules d'Euler** pour $\\cos\\theta$ et $\\sin\\theta$ ?", "verso": "$\\cos\\theta = \\dfrac{\\mathrm{e}^{i\\theta}+\\mathrm{e}^{-i\\theta}}{2}$ et $\\sin\\theta = \\dfrac{\\mathrm{e}^{i\\theta}-\\mathrm{e}^{-i\\theta}}{2i}$." },
    { "recto": "**Formule de Moivre** ?", "verso": "$(\\cos\\theta + i\\sin\\theta)^n = \\cos(n\\theta) + i\\sin(n\\theta)$, soit $(\\mathrm{e}^{i\\theta})^n = \\mathrm{e}^{in\\theta}$." },
    { "recto": "Angle $\\big(\\overrightarrow{AB},\\overrightarrow{AC}\\big)$ avec les affixes ?", "verso": "$\\big(\\overrightarrow{AB},\\overrightarrow{AC}\\big) = \\arg\\!\\left(\\dfrac{z_C-z_A}{z_B-z_A}\\right)$." },
    { "recto": "Suffit-il du cosinus pour déterminer un argument ?", "verso": "Non : il faut aussi le **signe du sinus** (partie imaginaire) pour trancher. Et $0$ n'a pas d'argument." }
  ]

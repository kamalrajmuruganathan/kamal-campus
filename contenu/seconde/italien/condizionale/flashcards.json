  "relu_par": null,
  "cartes": [
    {
      "recto": "Comment forme-t-on le condizionale presente ?",
      "verso": "Radical du futur + -ei, -esti, -ebbe, -emmo, -este, -ebbero."
    },
    {
      "recto": "Quels emplois principaux du conditionnel ?",
      "verso": "Politesse, désir, conseil, possibilité, hypothèse."
    },
    {
      "recto": "Condizionale de essere et avere (io) ?",
      "verso": "sarei et avrei."
    },
    {
      "recto": "Trois autres radicaux irréguliers ?",
      "verso": "volere → vorr- (vorrei), andare → andr- (andrei), fare → far- (farei)."
    },
    {
      "recto": "Piège orthographique du « noi » ?",
      "verso": "Conditionnel = deux m (parleremmo) ; futur = un seul m (parleremo)."
    },
    {
      "recto": "Comment forme-t-on le condizionale passato ?",
      "verso": "Condizionale de avere/essere + participe passé : avrei voluto, sarebbe partito."
    },
    {
      "recto": "Comment rend-on le « futur dans le passé » ?",
      "verso": "Par le condizionale passato : Ha detto che sarebbe arrivato (il a dit qu'il arriverait)."
    },
    {
      "recto": "Traduis « Je voudrais un café ».",
      "verso": "Vorrei un caffè."
    },
    {
      "recto": "Traduis « Tu devrais étudier davantage ».",
      "verso": "Dovresti studiare di più."
    },
    {
      "recto": "Radical conditionnel de potere, dovere, venire ?",
      "verso": "potr- (potrei), dovr- (dovrei), verr- (verrei)."
    },
    {
      "recto": "Traduis « On pourrait sortir ce soir ».",
      "verso": "Potremmo uscire stasera."
    },
    {
      "recto": "Radical conditionnel de rimanere et vedere ?",
      "verso": "rimarr- (rimarrei) et vedr- (vedrei)."
    }
  ]
}
  "cartes": [
    {
      "recto": "Combien de lettres a l'alphabet grec ?",
      "verso": "24 lettres, de alpha (α) à oméga (ω)."
    },
    {
      "recto": "Nom de la lettre α ?",
      "verso": "alpha ; elle se translittère « a »."
    },
    {
      "recto": "Translittération de φ, θ, χ, ψ ?",
      "verso": "φ = ph, θ = th, χ = kh, ψ = ps."
    },
    {
      "recto": "Article défini masculin singulier ?",
      "verso": "ὁ (ho) : ὁ λόγος, le discours."
    },
    {
      "recto": "Article défini féminin singulier ?",
      "verso": "ἡ (hê) : ἡ ἡμέρα, le jour."
    },
    {
      "recto": "Article défini neutre singulier ?",
      "verso": "τό (to) : τὸ δῶρον, le cadeau."
    },
    {
      "recto": "Que signifie λύω ?",
      "verso": "« je délie » ; c'est le verbe modèle."
    },
    {
      "recto": "Présent de λύω au singulier ?",
      "verso": "λύω (je délie), λύεις (tu délies), λύει (il délie)."
    },
    {
      "recto": "Verbe « être » au singulier ?",
      "verso": "εἰμί (je suis), εἶ (tu es), ἐστί(ν) (il est)."
    },
    {
      "recto": "Que note l'esprit rude ( ῾ ) ?",
      "verso": "Une aspiration « h » sur la voyelle initiale."
    },
    {
      "recto": "Différence entre η et ε ?",
      "verso": "η (êta) est un e long ; ε (epsilon) un e bref."
    },
    {
      "recto": "Différence entre ω et ο ?",
      "verso": "ω (oméga) est un o long ; ο (omicron) un o bref."
    }
  ]
}
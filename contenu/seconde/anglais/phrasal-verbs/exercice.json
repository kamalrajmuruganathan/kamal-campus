  "consigne": "Cherche chaque exercice au brouillon avant d'ouvrir le corrigé.",
  "exercices": [
    {
      "id": 1,
      "difficulte": "decouverte",
      "notion": "sens",
      "enonce": "Traduis « give up » et emploie-le : « N'abandonne pas ! »",
      "corrige": [
        "*give up* = abandonner.",
        "Impératif négatif : Don't + give up."
      ],
      "reponse": "Don't give up!"
    },
    {
      "id": 2,
      "difficulte": "decouverte",
      "notion": "sens",
      "enonce": "Complète avec le bon phrasal verb : She is ___ her glasses. (chercher)",
      "corrige": [
        "« chercher » = *look for*.",
        "« ...looking for her glasses. »"
      ],
      "reponse": "looking for her glasses"
    },
    {
      "id": 3,
      "difficulte": "decouverte",
      "notion": "separable",
      "enonce": "Réécris avec le pronom : Turn on the radio → Turn ___ ___.",
      "corrige": [
        "Objet pronom → au milieu.",
        "« Turn it on. »"
      ],
      "reponse": "Turn it on."
    },
    {
      "id": 4,
      "difficulte": "application",
      "notion": "separable",
      "enonce": "Réécris avec le pronom : Pick up the pen → Pick ___ ___.",
      "corrige": [
        "Le pronom objet se place entre verbe et particule.",
        "« Pick it up. »"
      ],
      "reponse": "Pick it up."
    },
    {
      "id": 5,
      "difficulte": "application",
      "notion": "inseparable",
      "enonce": "Corrige : I look my little brother after.",
      "corrige": [
        "*look after* est inséparable, la particule reste collée.",
        "« I look after my little brother. »"
      ],
      "reponse": "I look after my little brother."
    },
    {
      "id": 6,
      "difficulte": "application",
      "notion": "particule",
      "enonce": "Complète la particule : You can always depend ___ me.",
      "corrige": [
        "On dit *depend on*.",
        "« ...depend on me. »"
      ],
      "reponse": "on"
    },
    {
      "id": 7,
      "difficulte": "application",
      "notion": "sens",
      "enonce": "Traduis « The plane took off. »",
      "corrige": [
        "*take off* = décoller (pour un avion).",
        "Sujet + phrasal verb au prétérit."
      ],
      "reponse": "L'avion a décollé."
    },
    {
      "id": 8,
      "difficulte": "approfondissement",
      "notion": "sens",
      "enonce": "Complète avec « run out of » au present perfect : We've ___ ___ ___ sugar.",
      "corrige": [
        "*run out of* = ne plus avoir de ; participe passé *run*.",
        "« We've run out of sugar. »"
      ],
      "reponse": "run out of"
    },
    {
      "id": 9,
      "difficulte": "approfondissement",
      "notion": "separable",
      "enonce": "Corrige : Switch off it, please.",
      "corrige": [
        "Objet pronom → obligatoirement au milieu.",
        "« Switch it off, please. »"
      ],
      "reponse": "Switch it off, please."
    },
    {
      "id": 10,
      "difficulte": "approfondissement",
      "notion": "synthese",
      "enonce": "Traduis « Ils ont reporté la réunion. » (put off)",
      "corrige": [
        "*put off* = reporter ; prétérit *put off* (invariable).",
        "Sujet + put off + the meeting."
      ],
      "reponse": "They put off the meeting."
    }
  ]
}
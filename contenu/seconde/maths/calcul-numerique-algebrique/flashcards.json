{
  "id": "2nde-math-calcul-numerique-algebrique-cartes",
  "chapitre": "2nde-math-calcul-numerique-algebrique",
  "titre": "Cartes — Calcul numérique et algébrique",
  "voie": "generale",
  "niveau": "seconde",
  "parcours": "tronc-commun",
  "matiere": "mathematiques",
  "statut": "brouillon",
  "relu_par": null,
  "cartes": [
    {
      "recto": "Quelle est la chaîne d'inclusions des ensembles de nombres ?",
      "verso": "$\\mathbb{N} \\subset \\mathbb{Z} \\subset \\mathbb{D} \\subset \\mathbb{Q} \\subset \\mathbb{R}$"
    },
    {
      "recto": "Que vaut $a^m \\times a^n$ ?",
      "verso": "$a^{m+n}$ : on **additionne** les exposants (ce n'est pas $a^{mn}$)."
    },
    {
      "recto": "Que vaut $(a^m)^n$ ?",
      "verso": "$a^{mn}$ : on **multiplie** les exposants."
    },
    {
      "recto": "A-t-on $\\sqrt{a+b} = \\sqrt{a}+\\sqrt{b}$ ?",
      "verso": "Non, jamais. Contre-exemple : $\\sqrt{9+16}=5$ alors que $\\sqrt9+\\sqrt{16}=7$."
    },
    {
      "recto": "Que vaut $\\sqrt{a}\\times\\sqrt{b}$ pour $a,b\\geqslant 0$ ?",
      "verso": "$\\sqrt{ab}$."
    },
    {
      "recto": "Les trois identités remarquables ?",
      "verso": "$(a+b)^2=a^2+2ab+b^2$ ; $(a-b)^2=a^2-2ab+b^2$ ; $(a-b)(a+b)=a^2-b^2$."
    },
    {
      "recto": "Quel terme oublie-t-on le plus souvent en développant $(a+b)^2$ ?",
      "verso": "Le **double produit** $2ab$."
    },
    {
      "recto": "Énoncé de la règle du produit nul ?",
      "verso": "$A\\times B = 0 \\iff A=0 \\text{ ou } B=0$."
    },
    {
      "recto": "A-t-on $\\dfrac{a}{b}+\\dfrac{c}{d}=\\dfrac{a+c}{b+d}$ ?",
      "verso": "Non. Il faut mettre au **même dénominateur**. Contrôle : $\\tfrac12+\\tfrac12=1$, pas $\\tfrac12$."
    },
    {
      "recto": "Comment factoriser par facteur commun $ka+kb$ ?",
      "verso": "$ka+kb = k(a+b)$ ; le facteur commun peut être une expression entière."
    },
    {
      "recto": "Comment note-t-on l'intervalle des $x \\geqslant 3$ ?",
      "verso": "$[3\\,;+\\infty[$ : le crochet est **toujours ouvert** du côté de l'infini."
    }
  ]
}

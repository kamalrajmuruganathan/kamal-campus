{
  "id": "2nde-espagnol-verbos-pronominales-cartes",
  "chapitre": "2nde-espagnol-verbos-pronominales",
  "titre": "Cartes — Les verbes pronominaux (se)",
  "voie": "generale",
  "niveau": "seconde",
  "parcours": "espagnol",
  "matiere": "espagnol",
  "statut": "brouillon",
  "relu_par": null,
  "cartes": [
    {
      "recto": "Comment reconnaît-on un verbe pronominal à l'infinitif ?",
      "verso": "Il se termine par **-se** : *levantarse, ducharse*."
    },
    {
      "recto": "Les six pronoms réfléchis ?",
      "verso": "me, te, se, nos, os, se."
    },
    {
      "recto": "Conjugue *ducharse* à *yo*.",
      "verso": "**Me ducho.**"
    },
    {
      "recto": "Où se place le pronom avec un verbe conjugué ?",
      "verso": "Devant le verbe : *Me levanto.*"
    },
    {
      "recto": "Où se place le pronom avec un infinitif ?",
      "verso": "Collé à la fin : *Voy a levantarme.*"
    },
    {
      "recto": "Où se place le pronom avec un gérondif ?",
      "verso": "Collé à la fin (+ accent) : *duchándome*."
    },
    {
      "recto": "Impératif affirmatif de *levantarse* (tú) ?",
      "verso": "**¡Levántate!** (pronom collé + accent)."
    },
    {
      "recto": "Et à l'impératif négatif ?",
      "verso": "Pronom devant : *No te levantes.*"
    },
    {
      "recto": "Que signifie *irse* ?",
      "verso": "S'en aller : *Me voy.* (≠ *ir* = aller)."
    },
    {
      "recto": "Que signifie *dormirse* ?",
      "verso": "S'endormir (≠ *dormir* = dormir)."
    },
    {
      "recto": "Sens de *Se quieren* au pluriel ?",
      "verso": "Sens réciproque : ils s'aiment l'un l'autre."
    },
    {
      "recto": "Corrige : *Yo se levanto.*",
      "verso": "Faux → Yo **me** levanto."
    }
  ]
}
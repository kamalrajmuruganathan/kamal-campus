    {
      "recto": "Combien de syllabes dans l'alexandrin ?",
      "verso": "12 syllabes ; c'est le vers classique par excellence."
    },
    {
      "recto": "Octosyllabe et décasyllabe ?",
      "verso": "8 syllabes et 10 syllabes."
    },
    {
      "recto": "Qu'est-ce qu'un quatrain ? un tercet ?",
      "verso": "Un quatrain a quatre vers ; un tercet en a trois."
    },
    {
      "recto": "Schéma des rimes plates ?",
      "verso": "AABB (rimes suivies)."
    },
    {
      "recto": "Rimes croisées et embrassées ?",
      "verso": "Croisées : ABAB ; embrassées : ABBA."
    },
    {
      "recto": "Structure du sonnet ?",
      "verso": "Deux quatrains suivis de deux tercets."
    },
    {
      "recto": "Qu'est-ce que la césure ?",
      "verso": "La coupe qui partage l'alexandrin en deux hémistiches."
    },
    {
      "recto": "Qu'est-ce que la poésie lyrique ?",
      "verso": "Une poésie qui exprime les sentiments personnels (amour, fuite du temps)."
    },
    {
      "recto": "Que signifie « carpe diem » ?",
      "verso": "« Cueille le jour » : profite de l'instant présent."
    },
    {
      "recto": "La Pléiade, quel siècle ?",
      "verso": "Le XVIe siècle (Ronsard, Du Bellay)."
    },
    {
      "recto": "Quand le -e muet compte-t-il ?",
      "verso": "À l'intérieur du vers devant une consonne, jamais en fin de vers."
    },
    {
      "recto": "Un auteur du Moyen Âge en poésie ?",
      "verso": "François Villon, *Ballade des pendus*."
    }
  ]

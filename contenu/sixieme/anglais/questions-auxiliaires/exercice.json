{
  "id": "6e-anglais-questions-auxiliaires-exos",
  "chapitre": "6e-anglais-questions-auxiliaires",
  "titre": "Exercices — Poser des questions : do, does et les mots interrogatifs",
  "voie": "college",
  "niveau": "sixieme",
  "parcours": "anglais",
  "matiere": "anglais",
  "statut": "brouillon",
  "relu_par": null,
  "consigne": "Cherche chaque exercice au brouillon avant d'ouvrir le corrigé.",
  "exercices": [
    {
      "id": 1,
      "difficulte": "decouverte",
      "notion": "auxiliaire",
      "enonce": "Complète avec do ou does : ___ you play tennis?",
      "corrige": [
        "Sujet « you » → auxiliaire *do*.",
        "« Do you play tennis? »"
      ],
      "reponse": "Do you play tennis?"
    },
    {
      "id": 2,
      "difficulte": "decouverte",
      "notion": "auxiliaire",
      "enonce": "Complète avec do ou does : ___ he like music?",
      "corrige": [
        "Sujet « he » (3e pers. sing.) → *does*.",
        "« Does he like music? »"
      ],
      "reponse": "Does he like music?"
    },
    {
      "id": 3,
      "difficulte": "application",
      "notion": "forme-verbe",
      "enonce": "Corrige la phrase : Does she works here?",
      "corrige": [
        "Après *does*, le verbe reste à la base, sans -s.",
        "On enlève le -s de « works »."
      ],
      "reponse": "Does she work here?"
    },
    {
      "id": 4,
      "difficulte": "application",
      "notion": "verbe-be",
      "enonce": "Transforme en question : You are tired.",
      "corrige": [
        "Avec *be*, on inverse sujet et verbe, sans *do*.",
        "« Are you tired? »"
      ],
      "reponse": "Are you tired?"
    },
    {
      "id": 5,
      "difficulte": "application",
      "notion": "ordre",
      "enonce": "Remets dans l'ordre : does / Where / she / live?",
      "corrige": [
        "Ordre : mot interrogatif + auxiliaire + sujet + verbe.",
        "Where + does + she + live."
      ],
      "reponse": "Where does she live?"
    },
    {
      "id": 6,
      "difficulte": "application",
      "notion": "mot-interrogatif",
      "enonce": "Complète avec le bon mot interrogatif : ___ do you get up? (à quelle heure)",
      "corrige": [
        "On demande un moment → *When*.",
        "« When do you get up? »"
      ],
      "reponse": "When do you get up?"
    },
    {
      "id": 7,
      "difficulte": "application",
      "notion": "auxiliaire",
      "enonce": "Transforme en question : They speak French.",
      "corrige": [
        "Sujet « they » → *do* ; verbe à la base.",
        "« Do they speak French? »"
      ],
      "reponse": "Do they speak French?"
    },
    {
      "id": 8,
      "difficulte": "approfondissement",
      "notion": "erreur",
      "enonce": "Corrige : Do you are English?",
      "corrige": [
        "Avec *be* (are), pas d'auxiliaire *do*.",
        "On garde seulement l'inversion avec *be*."
      ],
      "reponse": "Are you English?"
    },
    {
      "id": 9,
      "difficulte": "approfondissement",
      "notion": "synthese",
      "enonce": "Traduis en anglais : Pourquoi pleure-t-il ?",
      "corrige": [
        "« Pourquoi » = Why ; « il » → *does* ; verbe base *cry*.",
        "Why + does + he + cry."
      ],
      "reponse": "Why does he cry?"
    },
    {
      "id": 10,
      "difficulte": "approfondissement",
      "notion": "synthese",
      "enonce": "Traduis en anglais : Est-ce que ta sœur aime le chocolat ?",
      "corrige": [
        "« your sister » = 3e pers. sing. → *does* ; verbe base *like*.",
        "Does + your sister + like + chocolate."
      ],
      "reponse": "Does your sister like chocolate?"
    }
  ]
}
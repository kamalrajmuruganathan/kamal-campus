{
  "id": "6e-anglais-questions-auxiliaires-cartes",
  "chapitre": "6e-anglais-questions-auxiliaires",
  "titre": "Cartes — Poser des questions : do, does et les mots interrogatifs",
  "voie": "college",
  "niveau": "sixieme",
  "parcours": "anglais",
  "matiere": "anglais",
  "statut": "brouillon",
  "relu_par": null,
  "cartes": [
    {
      "recto": "Quel auxiliaire pour poser une question au présent simple ?",
      "verso": "*do* (I/you/we/they) ou *does* (he/she/it)."
    },
    {
      "recto": "Où place-t-on l'auxiliaire dans une question ?",
      "verso": "Au début : « **Do** you like tea? »."
    },
    {
      "recto": "Que devient le verbe après *does* ?",
      "verso": "Il reste à la base, sans -s : « Does she **play**? »."
    },
    {
      "recto": "Comment pose-t-on une question avec le verbe *be* ?",
      "verso": "Pas de *do* : on inverse sujet et verbe : « **Are** you ready? »."
    },
    {
      "recto": "Traduis « Où habite-t-il ? »",
      "verso": "Where does he live?"
    },
    {
      "recto": "Traduis « Qu'est-ce que tu veux ? »",
      "verso": "What do you want?"
    },
    {
      "recto": "Que veut dire *when* ?",
      "verso": "« Quand » : « **When** do we start? »."
    },
    {
      "recto": "Que veut dire *why* ?",
      "verso": "« Pourquoi » : « **Why** do you cry? »."
    },
    {
      "recto": "Quel est l'ordre des mots dans une question avec mot interrogatif ?",
      "verso": "Mot interrogatif + auxiliaire + sujet + verbe."
    },
    {
      "recto": "Corrige : « Does he plays football? »",
      "verso": "« Does he **play** football? » (pas de -s après *does*)."
    },
    {
      "recto": "Traduis « Es-tu français ? »",
      "verso": "Are you French?"
    },
    {
      "recto": "Que veut dire *how* ?",
      "verso": "« Comment » : « **How** does it work? »."
    }
  ]
}
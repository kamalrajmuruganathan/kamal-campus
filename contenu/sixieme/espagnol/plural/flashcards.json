  "cartes": [
    {
      "recto": "Règle du pluriel après une voyelle",
      "verso": "On ajoute **-s** : casa → casas."
    },
    {
      "recto": "Règle du pluriel après une consonne",
      "verso": "On ajoute **-es** : papel → papeles."
    },
    {
      "recto": "Règle du pluriel pour un mot en -z",
      "verso": "Le -z devient **-ces** : lápiz → lápices."
    },
    {
      "recto": "Pluriel de « profesor »",
      "verso": "**profesores** (consonne → +es)."
    },
    {
      "recto": "Pluriel de « ciudad »",
      "verso": "**ciudades** (consonne → +es)."
    },
    {
      "recto": "Pluriel de « pez »",
      "verso": "**peces** (z → ces)."
    },
    {
      "recto": "Pluriel de « luz »",
      "verso": "**luces** (z → ces)."
    },
    {
      "recto": "Pluriel de « coche »",
      "verso": "**coches** (voyelle → +s)."
    },
    {
      "recto": "« el libro » au pluriel",
      "verso": "**los libros** (article aussi au pluriel)."
    },
    {
      "recto": "« la ciudad » au pluriel",
      "verso": "**las ciudades**."
    },
    {
      "recto": "Erreur fréquente à éviter",
      "verso": "Ne pas écrire *papels* ni *lápizs* : c'est **papeles** et **lápices**."
    },
    {
      "recto": "« el lápiz » au pluriel",
      "verso": "**los lápices**."
    }
  ]

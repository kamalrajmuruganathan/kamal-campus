      "recto": "Comment dit-on « je » ?",
      "verso": "**yo**."
    },
    {
      "recto": "Comment dit-on « tu » ?",
      "verso": "**tú** (avec accent)."
    },
    {
      "recto": "Les trois pronoms de la 3e personne du singulier",
      "verso": "**él / ella / usted** (il / elle / vous de politesse)."
    },
    {
      "recto": "Comment dit-on « nous » ?",
      "verso": "**nosotros** (masc./mixte) ou **nosotras** (féminin)."
    },
    {
      "recto": "Comment dit-on « vous » (tutoiement pluriel, Espagne) ?",
      "verso": "**vosotros / vosotras**."
    },
    {
      "recto": "Comment dit-on « ils / elles » ?",
      "verso": "**ellos** (masc./mixte) / **ellas** (féminin)."
    },
    {
      "recto": "À quelle personne se conjugue *usted* ?",
      "verso": "À la **3e personne** : usted habla, usted es."
    },
    {
      "recto": "Différence entre *tú* et *tu*",
      "verso": "**tú** = pronom « tu » ; **tu** = adjectif « ton/ta »."
    },
    {
      "recto": "En Amérique latine, « vous » au pluriel se dit…",
      "verso": "**ustedes** (pas vosotros)."
    },
    {
      "recto": "Pourquoi peut-on omettre le pronom sujet ?",
      "verso": "Car la **terminaison du verbe** indique déjà la personne : *Hablo español.*"
    },
    {
      "recto": "Pronom pour un groupe uniquement de filles (« nous »)",
      "verso": "**nosotras**."
    },
    {
      "recto": "Comment vouvoie-t-on une personne ?",
      "verso": "Avec **usted** : *¿Cómo está usted?*"
    }

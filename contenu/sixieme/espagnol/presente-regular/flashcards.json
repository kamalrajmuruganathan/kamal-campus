  "relu_par": null,
  "cartes": [
    {
      "recto": "Les trois groupes de verbes réguliers",
      "verso": "**-ar** (hablar), **-er** (comer), **-ir** (vivir)."
    },
    {
      "recto": "Terminaisons du présent en -ar",
      "verso": "-o, -as, -a, -amos, -áis, -an."
    },
    {
      "recto": "Terminaisons du présent en -er",
      "verso": "-o, -es, -e, -emos, -éis, -en."
    },
    {
      "recto": "Terminaisons du présent en -ir",
      "verso": "-o, -es, -e, -imos, -ís, -en."
    },
    {
      "recto": "Conjugue « hablar » au présent",
      "verso": "hablo, hablas, habla, hablamos, habláis, hablan."
    },
    {
      "recto": "Conjugue « comer » au présent",
      "verso": "como, comes, come, comemos, coméis, comen."
    },
    {
      "recto": "Conjugue « vivir » au présent",
      "verso": "vivo, vives, vive, vivimos, vivís, viven."
    },
    {
      "recto": "Terminaison de la 1re personne (yo) pour tous les groupes",
      "verso": "Toujours **-o** : hablo, como, vivo."
    },
    {
      "recto": "Où -er et -ir diffèrent-ils ?",
      "verso": "À **nosotros** (-emos / -imos) et **vosotros** (-éis / -ís)."
    },
    {
      "recto": "Comment trouve-t-on le radical ?",
      "verso": "On enlève la terminaison -ar/-er/-ir : habl-, com-, viv-."
    },
    {
      "recto": "Traduis « nous vivons »",
      "verso": "**vivimos** (vivir → -imos)."
    },
    {
      "recto": "Erreur fréquente à éviter",
      "verso": "Ne pas dire *vivemos* : c'est **vivimos** (verbe en -ir)."
    }
  ]
}
      "recto": "Les noms en -o sont généralement…",
      "verso": "**masculins** : el libro, el gato."
    },
    {
      "recto": "Les noms en -a sont généralement…",
      "verso": "**féminins** : la casa, la mesa."
    },
    {
      "recto": "Les 4 articles définis",
      "verso": "**el, la, los, las** (le, la, les)."
    },
    {
      "recto": "Les 4 articles indéfinis",
      "verso": "**un, una, unos, unas** (un, une, des)."
    },
    {
      "recto": "Article défini masculin pluriel",
      "verso": "**los** : los libros."
    },
    {
      "recto": "Article défini féminin pluriel",
      "verso": "**las** : las casas."
    },
    {
      "recto": "Comment dit-on « des amis » ?",
      "verso": "**unos amigos** (masculin pluriel)."
    },
    {
      "recto": "Différence entre *el* et *él*",
      "verso": "**el** = l'article « le » ; **él** = le pronom « lui »."
    },
    {
      "recto": "Exception : « día » est…",
      "verso": "**masculin** : el día (finit en -a mais masculin)."
    },
    {
      "recto": "Exception : « mano » est…",
      "verso": "**féminin** : la mano (finit en -o mais féminin)."
    },
    {
      "recto": "Exception : « problema » est…",
      "verso": "**masculin** : el problema."
    },
    {
      "recto": "L'article s'accorde avec…",
      "verso": "le nom espagnol, en **genre** et en **nombre**."
    }

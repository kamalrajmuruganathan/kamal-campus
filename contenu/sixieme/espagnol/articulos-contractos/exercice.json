  "consigne": "Cherche chaque exercice au brouillon avant d'ouvrir le corrigé.",
  "exercices": [
    {
      "id": 1,
      "difficulte": "decouverte",
      "notion": "al",
      "enonce": "Contracte si nécessaire : Voy (a + el) parque.",
      "corrige": [
        "*a + el = al*.",
        "Voy **al** parque."
      ],
      "reponse": "Voy al parque."
    },
    {
      "id": 2,
      "difficulte": "decouverte",
      "notion": "del",
      "enonce": "Contracte si nécessaire : Vengo (de + el) trabajo.",
      "corrige": [
        "*de + el = del*.",
        "Vengo **del** trabajo."
      ],
      "reponse": "Vengo del trabajo."
    },
    {
      "id": 3,
      "difficulte": "decouverte",
      "notion": "pas-de-contraction",
      "enonce": "Complète : Vamos (a + la) piscina.",
      "corrige": [
        "Avec *la*, aucune contraction.",
        "Vamos **a la** piscina."
      ],
      "reponse": "Vamos a la piscina."
    },
    {
      "id": 4,
      "difficulte": "application",
      "notion": "al",
      "enonce": "Traduis : Je vais au restaurant.",
      "corrige": [
        "*au = a + el = al*.",
        "**Voy al restaurante.**"
      ],
      "reponse": "Voy al restaurante."
    },
    {
      "id": 5,
      "difficulte": "application",
      "notion": "del",
      "enonce": "Traduis : C'est le livre du professeur.",
      "corrige": [
        "*du = de + el = del*.",
        "**Es el libro del profesor.**"
      ],
      "reponse": "Es el libro del profesor."
    },
    {
      "id": 6,
      "difficulte": "application",
      "notion": "mixte",
      "enonce": "Complète les blancs : Salgo ___ colegio y voy ___ cine.",
      "corrige": [
        "*de + el = del* ; *a + el = al*.",
        "Salgo **del** colegio y voy **al** cine."
      ],
      "reponse": "Salgo del colegio y voy al cine."
    },
    {
      "id": 7,
      "difficulte": "application",
      "notion": "pas-de-contraction",
      "enonce": "Complète : La bicicleta ___ (de + los) niños es nueva.",
      "corrige": [
        "*de los* ne se contracte pas.",
        "La bicicleta **de los** niños es nueva."
      ],
      "reponse": "La bicicleta de los niños es nueva."
    },
    {
      "id": 8,
      "difficulte": "approfondissement",
      "notion": "repere-erreur",
      "enonce": "Corrige la phrase : Vengo de el mercado.",
      "corrige": [
        "*de el* est interdit : *de + el = del*.",
        "Vengo **del** mercado."
      ],
      "reponse": "Vengo del mercado."
    },
    {
      "id": 9,
      "difficulte": "approfondissement",
      "notion": "nom-propre",
      "enonce": "Traduis en faisant attention : Il vient d'El Salvador.",
      "corrige": [
        "*El Salvador* est un nom propre : pas de contraction.",
        "**Viene de El Salvador.**"
      ],
      "reponse": "Viene de El Salvador."
    },
    {
      "id": 10,
      "difficulte": "approfondissement",
      "notion": "synthese",
      "enonce": "Complète : Damos de comer ___ (a + el) gato cerca ___ (de + la) puerta.",
      "corrige": [
        "*a + el = al* ; *de la* ne se contracte pas.",
        "Damos de comer **al** gato cerca **de la** puerta."
      ],
      "reponse": "Damos de comer al gato cerca de la puerta."
    }
  ]
}
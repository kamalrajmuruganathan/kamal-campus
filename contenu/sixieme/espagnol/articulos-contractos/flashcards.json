{
  "id": "6e-espagnol-articulos-contractos-cartes",
  "chapitre": "6e-espagnol-articulos-contractos",
  "titre": "Cartes — Les articles contractés al et del",
  "voie": "college",
  "niveau": "sixieme",
  "parcours": "espagnol",
  "matiere": "espagnol",
  "statut": "brouillon",
  "relu_par": null,
  "cartes": [
    {
      "recto": "a + el = ?",
      "verso": "**al** : Voy **al** cine."
    },
    {
      "recto": "de + el = ?",
      "verso": "**del** : Vengo **del** parque."
    },
    {
      "recto": "La contraction est-elle obligatoire ?",
      "verso": "Oui : on n'écrit jamais *a el* ni *de el*."
    },
    {
      "recto": "Que devient *a + la* ?",
      "verso": "Rien ! *a la* reste : Voy **a la** playa."
    },
    {
      "recto": "Que devient *de + los* ?",
      "verso": "Rien ! *de los* reste : La casa **de los** vecinos."
    },
    {
      "recto": "Avec quel article la contraction se fait-elle ?",
      "verso": "Seulement *el* (masculin singulier)."
    },
    {
      "recto": "Traduis : Je vais au restaurant.",
      "verso": "Voy **al** restaurante."
    },
    {
      "recto": "Traduis : C'est le sac du garçon.",
      "verso": "Es la mochila **del** niño."
    },
    {
      "recto": "*Vengo de El Salvador* : pourquoi pas *del* ?",
      "verso": "*El Salvador* est un nom propre : pas de contraction."
    },
    {
      "recto": "Repère l'erreur : *Voy a el mercado.*",
      "verso": "Faux → **al** mercado."
    },
    {
      "recto": "Traduis : Elle écrit au directeur.",
      "verso": "Escribe **al** director."
    },
    {
      "recto": "Vrai ou faux : *a las* et *de las* peuvent se contracter.",
      "verso": "Faux : ils ne se contractent jamais."
    }
  ]
}
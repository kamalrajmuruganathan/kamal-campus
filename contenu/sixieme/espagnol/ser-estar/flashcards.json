  "relu_par": null,
  "cartes": [
    {
      "recto": "Combien de verbes espagnols traduisent « être » ?",
      "verso": "Deux : **ser** et **estar**."
    },
    {
      "recto": "Conjugue *ser* au présent.",
      "verso": "soy, eres, es, somos, sois, son."
    },
    {
      "recto": "Conjugue *estar* au présent.",
      "verso": "estoy, estás, está, estamos, estáis, están."
    },
    {
      "recto": "Quel verbe pour l'origine et la nationalité ?",
      "verso": "**ser** : *Soy español.*"
    },
    {
      "recto": "Quel verbe pour dire où l'on se trouve ?",
      "verso": "**estar** : *Estoy en casa.* / *Madrid está en España.*"
    },
    {
      "recto": "Quel verbe pour une humeur ou un sentiment ?",
      "verso": "**estar** : *Estoy contento.*"
    },
    {
      "recto": "Comment dit-on « Il est trois heures » ?",
      "verso": "*Son las tres.* (heure au pluriel → ser)."
    },
    {
      "recto": "Ser ou estar : la profession ?",
      "verso": "**ser** : *Mi madre es profesora.*"
    },
    {
      "recto": "Traduis « Je suis fatigué. »",
      "verso": "*Estoy cansado.* (état passager → estar)."
    },
    {
      "recto": "Comment demande-t-on « Comment vas-tu ? »",
      "verso": "*¿Cómo estás?* (état → estar)."
    },
    {
      "recto": "Ser ou estar : « La sopa ___ fría » (froide maintenant) ?",
      "verso": "**estar** : *La sopa está fría.*"
    },
    {
      "recto": "Astuce mémoire pour estar",
      "verso": "**estar** = **e**mplacement + **é**tat passager (¿dónde? / ¿cómo?)."
    }
  ]
}
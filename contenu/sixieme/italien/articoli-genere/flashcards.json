  "cartes": [
    {
      "recto": "Genre des noms en -o et en -a ?",
      "verso": "-o → masculin (il libro) ; -a → féminin (la casa)."
    },
    {
      "recto": "Les noms en -e sont de quel genre ?",
      "verso": "Masculin ou féminin selon le mot : il fiore (m.), la chiave (f.)."
    },
    {
      "recto": "Article défini masculin devant consonne ?",
      "verso": "il : il libro, il cane."
    },
    {
      "recto": "Article défini masculin devant s+consonne ou z ?",
      "verso": "lo : lo studente, lo zaino."
    },
    {
      "recto": "Article défini devant voyelle ?",
      "verso": "l' : l'amico (m.), l'amica (f.)."
    },
    {
      "recto": "Article défini féminin devant consonne ?",
      "verso": "la : la casa, la penna."
    },
    {
      "recto": "Article indéfini masculin (cas général) ?",
      "verso": "un : un libro, un amico."
    },
    {
      "recto": "Article indéfini masculin devant s+consonne ou z ?",
      "verso": "uno : uno studente, uno zaino."
    },
    {
      "recto": "Article indéfini féminin devant consonne ?",
      "verso": "una : una casa."
    },
    {
      "recto": "Article indéfini féminin devant voyelle ?",
      "verso": "un' : un'amica, un'ora."
    },
    {
      "recto": "un amico ou un'amico ?",
      "verso": "un amico : le masculin ne prend jamais d'apostrophe."
    },
    {
      "recto": "Article de « lo specchio » : pourquoi lo ?",
      "verso": "Parce que le mot commence par s+consonne (sp-)."
    }
  ]
}
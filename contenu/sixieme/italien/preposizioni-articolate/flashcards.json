    {
      "recto": "a + il / a + la ?",
      "verso": "al / alla."
    },
    {
      "recto": "di + il / di + la ?",
      "verso": "del / della."
    },
    {
      "recto": "in + il / in + la ?",
      "verso": "nel / nella."
    },
    {
      "recto": "su + il / su + la ?",
      "verso": "sul / sulla."
    },
    {
      "recto": "da + il / da + la ?",
      "verso": "dal / dalla."
    },
    {
      "recto": "a + i / a + gli / a + le ?",
      "verso": "ai / agli / alle."
    },
    {
      "recto": "di + i / di + gli / di + le ?",
      "verso": "dei / degli / delle."
    },
    {
      "recto": "in + i / in + gli / in + le ?",
      "verso": "nei / negli / nelle."
    },
    {
      "recto": "Traduis : « Je vais au cinéma. »",
      "verso": "Vado al cinema. (a + il)"
    },
    {
      "recto": "Traduis : « Le livre du garçon. »",
      "verso": "Il libro del ragazzo. (di + il)"
    },
    {
      "recto": "Quelles prépositions ne fusionnent pas ?",
      "verso": "con (avec) et per (pour) : con il cane, per il papà."
    },
    {
      "recto": "Comment choisir la bonne forme articulée ?",
      "verso": "Selon l'article du nom qui suit : nel giardino (il) mais nella casa (la)."
    }
  ]

      "recto": "Conjugue essere (être) au présent.",
      "verso": "io sono, tu sei, lui/lei è, noi siamo, voi siete, loro sono."
    },
    {
      "recto": "Conjugue avere (avoir) au présent.",
      "verso": "io ho, tu hai, lui/lei ha, noi abbiamo, voi avete, loro hanno."
    },
    {
      "recto": "Comment dit-on son âge en italien ?",
      "verso": "Avec avere : Ho dodici anni (= j'ai douze ans)."
    },
    {
      "recto": "Je suis italien.",
      "verso": "Io sono italiano."
    },
    {
      "recto": "Tu es sympathique.",
      "verso": "Tu sei simpatico."
    },
    {
      "recto": "Elle est française.",
      "verso": "Lei è francese."
    },
    {
      "recto": "Nous avons soif.",
      "verso": "Abbiamo sete."
    },
    {
      "recto": "Ils ont deux chats.",
      "verso": "Loro hanno due gatti."
    },
    {
      "recto": "Le « h » de ho, hai, ha, hanno se prononce-t-il ?",
      "verso": "Non, il est toujours muet."
    },
    {
      "recto": "Différence entre è et e ?",
      "verso": "è (avec accent) = verbe être (il/elle est) ; e = « et »."
    },
    {
      "recto": "Différence entre hanno et anno ?",
      "verso": "hanno = ils ont (verbe avere) ; anno = année."

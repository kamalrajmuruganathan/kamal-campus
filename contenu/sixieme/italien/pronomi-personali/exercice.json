      "id": 1,
      "difficulte": "decouverte",
      "notion": "pronome",
      "enonce": "Traduis : « je ».",
      "corrige": [
        "Pronom sujet 1re personne.",
        "**io**."
      ],
      "reponse": "io"
    },
    {
      "id": 2,
      "difficulte": "decouverte",
      "notion": "pronome",
      "enonce": "Traduis : « elle ».",
      "corrige": [
        "Pronom sujet féminin singulier.",
        "**lei**."
      ],
      "reponse": "lei"
    },
    {
      "id": 3,
      "difficulte": "application",
      "notion": "sostituzione",
      "enonce": "Remplace « Luca » par un pronom.",
      "corrige": [
        "Masculin singulier → lui.",
        "**lui**."
      ],
      "reponse": "lui"
    },
    {
      "id": 4,
      "difficulte": "application",
      "notion": "sostituzione",
      "enonce": "Remplace « Anna e Maria » par un pronom.",
      "corrige": [
        "Deux personnes → loro.",
        "**loro**."
      ],
      "reponse": "loro"
    },
    {
      "id": 5,
      "difficulte": "application",
      "notion": "sostituzione",
      "enonce": "Remplace « tu e io » par un pronom.",
      "corrige": [
        "« toi et moi » → noi.",
        "**noi**."
      ],
      "reponse": "noi"
    },
    {
      "id": 6,
      "difficulte": "application",
      "notion": "verbo-pronome",
      "enonce": "Quel pronom va avec « avete » ?",
      "corrige": [
        "avete = 2e personne du pluriel.",
        "**voi**."
      ],
      "reponse": "voi"
    },
    {
      "id": 7,
      "difficulte": "approfondissement",
      "notion": "cortesia",
      "enonce": "Comment vouvoie-t-on poliment une personne ?",
      "corrige": [
        "On emploie Lei (majuscule).",
        "Ex. : **Lei è italiano?**"
      ],
      "reponse": "Lei"
    },
    {
      "id": 8,
      "difficulte": "approfondissement",
      "notion": "uso",
      "enonce": "Réécris sans le pronom : « Io sono stanco. »",
      "corrige": [
        "Le verbe indique déjà io.",
        "**Sono stanco.**"
      ],
      "reponse": "Sono stanco."
    },
    {
      "id": 9,
      "difficulte": "approfondissement",
      "notion": "traduction",
      "enonce": "Traduis : « Vous êtes français. » (pluriel)",
      "corrige": [
        "« vous » pluriel = voi ; essere → siete.",
        "**Voi siete francesi.**"
      ],
      "reponse": "Voi siete francesi."
    },
    {
      "id": 10,
      "difficulte": "approfondissement",
      "notion": "distinzione",
      "enonce": "Corrige : « Lui è mia sorella. »",
      "corrige": [
        "Une sœur est féminine → lei.",
        "**Lei è mia sorella.**"
      ],
      "reponse": "Lei è mia sorella."
    }
  ]

  "statut": "brouillon",
  "relu_par": null,
  "cartes": [
    {
      "recto": "Les sept pronoms sujets italiens ?",
      "verso": "io, tu, lui, lei, noi, voi, loro."
    },
    {
      "recto": "io / tu → ?",
      "verso": "je / tu."
    },
    {
      "recto": "lui / lei → ?",
      "verso": "il / elle."
    },
    {
      "recto": "noi / voi / loro → ?",
      "verso": "nous / vous / ils(elles)."
    },
    {
      "recto": "Pourquoi omet-on souvent le pronom sujet ?",
      "verso": "Parce que la terminaison du verbe indique déjà la personne (Sono stanco = Je suis fatigué)."
    },
    {
      "recto": "Comment vouvoyer poliment en italien ?",
      "verso": "Avec Lei (souvent majuscule) : Lei è italiano?"
    },
    {
      "recto": "« Marco et moi » = quel pronom ?",
      "verso": "noi."
    },
    {
      "recto": "« toi et Anna » = quel pronom ?",
      "verso": "voi."
    },
    {
      "recto": "Pronom qui va avec siamo ?",
      "verso": "noi (noi siamo)."
    },
    {
      "recto": "Pronom qui va avec hai ?",
      "verso": "tu (tu hai)."
    },
    {
      "recto": "Ne pas confondre : lui et lei ?",
      "verso": "lui = il (masculin) ; lei = elle (féminin)."
    },
    {
      "recto": "Quand garde-t-on le pronom sujet ?",
      "verso": "Pour insister ou opposer : Io sono italiano, tu sei francese."
    }
  ]
}
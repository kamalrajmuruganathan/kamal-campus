  "titre": "Cartes — Latin : propositions subordonnées et ablatif absolu",
  "voie": "college",
  "niveau": "troisieme",
  "parcours": "langues-anciennes",
  "matiere": "langues-anciennes",
  "statut": "brouillon",
  "relu_par": null,
  "cartes": [
    {
      "recto": "Pronom relatif latin (N. sing.) ?",
      "verso": "qui (m.), quae (f.), quod (n.) = « qui, que »."
    },
    {
      "recto": "Sens de ubi (conjonction) ?",
      "verso": "Quand, lorsque (subordonnée de temps)."
    },
    {
      "recto": "Sens de quod (cause) ?",
      "verso": "Parce que."
    },
    {
      "recto": "Sens de ut + subjonctif ?",
      "verso": "Pour que, afin que (but)."
    },
    {
      "recto": "Qu'est-ce qu'un ablatif absolu ?",
      "verso": "Un nom + un participe, tous deux à l'ablatif, détachés de la phrase."
    },
    {
      "recto": "Traduis « Urbe capta ».",
      "verso": "« La ville ayant été prise / une fois la ville prise. »"
    },
    {
      "recto": "Traduis « Caesare duce ».",
      "verso": "« César étant chef / sous le commandement de César. »"
    },
    {
      "recto": "Traduis « Bello finito ».",
      "verso": "« La guerre étant finie / après la fin de la guerre. »"
    },
    {
      "recto": "Que veut dire « captus, -a, -um » ?",
      "verso": "Participe parfait passif : « ayant été pris »."
    },
    {
      "recto": "Pourquoi « absolu » ?",
      "verso": "Parce que le groupe est détaché, sans lien grammatical avec le verbe principal."
    },
    {
      "recto": "Comment traduire un ablatif absolu ?",
      "verso": "Par une subordonnée circonstancielle (« lorsque… ») ou un groupe nominal."
    },
    {
      "recto": "Que veut dire « urbs, urbis » ?",
      "verso": "La ville (souvent Rome)."
    }
  ]
}
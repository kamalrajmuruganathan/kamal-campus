  "cartes": [
    {
      "recto": "Combien de lettres dans l'alphabet grec ?",
      "verso": "24 lettres, de alpha (α) à oméga (ω)."
    },
    {
      "recto": "Nom de la lettre α ?",
      "verso": "alpha (son [a])."
    },
    {
      "recto": "Nom de la lettre ω ?",
      "verso": "oméga (le o long)."
    },
    {
      "recto": "Les sept voyelles grecques ?",
      "verso": "α, ε, η, ι, ο, υ, ω."
    },
    {
      "recto": "epsilon (ε) vs êta (η) ?",
      "verso": "ε = e bref ; η = ê long."
    },
    {
      "recto": "omicron (ο) vs oméga (ω) ?",
      "verso": "ο = o bref ; ω = o long."
    },
    {
      "recto": "Les deux formes du sigma ?",
      "verso": "σ au début/milieu du mot, ς en fin de mot."
    },
    {
      "recto": "Que fait l'esprit rude (῾) ?",
      "verso": "Il ajoute un son [h] sur la voyelle initiale (ἡμέρα = hêméra)."
    },
    {
      "recto": "Sons de ξ et ψ ?",
      "verso": "ξ (xi) = [ks] ; ψ (psi) = [ps]."
    },
    {
      "recto": "Que veut dire δῆμος (dêmos) ?",
      "verso": "Le peuple (→ démocratie)."
    },
    {
      "recto": "Que veut dire πόλις (polis) ?",
      "verso": "La cité (→ politique, métropole)."
    },
    {
      "recto": "Décompose « philosophie ».",
      "verso": "φιλία (amour) + σοφία (sagesse) = « l'amour de la sagesse »."
    }
  ]
}
  "cartes": [
    {
      "recto": "Que remplace la particule « ne » ?",
      "verso": "Une quantité ou un complément en « di » (« en » en français)."
    },
    {
      "recto": "Que remplace la particule « ci » ?",
      "verso": "Un lieu ou un complément en « a » (« y » en français)."
    },
    {
      "recto": "« Ne voglio tre » signifie ?",
      "verso": "J'en veux trois (quantité)."
    },
    {
      "recto": "« Ci vado domani » signifie ?",
      "verso": "J'y vais demain (lieu)."
    },
    {
      "recto": "« Il y a » au singulier / au pluriel ?",
      "verso": "c'è (sing.) / ci sono (plur.)."
    },
    {
      "recto": "« Pensare a » avec particule ?",
      "verso": "ci : Ci penso (j'y pense)."
    },
    {
      "recto": "Accord du participe avec « ne » de quantité ?",
      "verso": "Le participe s'accorde : Ne ho mangiate due (des pizzas)."
    },
    {
      "recto": "Où placer ne / ci ?",
      "verso": "Avant le verbe conjugué ; collés à l'infinitif, l'impératif affirmatif et le gérondif."
    },
    {
      "recto": "« Il y en a beaucoup » ?",
      "verso": "Ce ne sono molti (ci → ce devant ne)."
    },
    {
      "recto": "« Je n'en peux plus » ?",
      "verso": "Non ne posso più."
    },
    {
      "recto": "« Parles-en ! » (tu) ?",
      "verso": "Parlane !"
    },
    {
      "recto": "« Va-t'en ! » (tu) ?",
      "verso": "Vattene ! (ti + ne collés à l'impératif)."
    }
  ]
}
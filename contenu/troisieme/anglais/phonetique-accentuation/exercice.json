      "corrige": [
        "« maps » → /s/ (après /p/ sourd).",
        "« pens » → /z/ (après /n/ sonore).",
        "« watches » → /ɪz/ (après /tʃ/).",
        "« trees » → /z/ (après une voyelle sonore)."
      ],
      "reponse": "maps /s/, pens /z/, watches /ɪz/, trees /z/"

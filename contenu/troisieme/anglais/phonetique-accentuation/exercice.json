      "id": 1,
      "difficulte": "decouverte",
      "notion": "ed",
      "enonce": "Classe ces verbes selon la prononciation du « -ed » : « worked », « played », « wanted ».",
      "corrige": [
        "/t/ : « worked » (finit par un son sourd /k/).",
        "/d/ : « played » (finit par un son sonore).",
        "/ɪd/ : « wanted » (finit par /t/)."
      ],
      "reponse": "/t/ : worked — /d/ : played — /ɪd/ : wanted"
    },
    {
      "id": 2,
      "difficulte": "decouverte",
      "notion": "pluriel",
      "enonce": "Classe ces pluriels selon le son du « -s » : « cats », « dogs », « boxes ».",
      "corrige": [
        "/s/ : « cats » (après un son sourd /t/).",
        "/z/ : « dogs » (après un son sonore /g/).",
        "/ɪz/ : « boxes » (après une sifflante)."
      ],
      "reponse": "/s/ : cats — /z/ : dogs — /ɪz/ : boxes"
    },
    {
      "id": 3,
      "difficulte": "application",
      "notion": "ed",
      "enonce": "Donne la prononciation du « -ed » : « helped », « cleaned », « needed », « watched ».",
      "corrige": [
        "« helped » → /t/ (après /p/ sourd).",
        "« cleaned » → /d/ (après /n/ sonore).",
        "« needed » → /ɪd/ (après /d/).",
        "« watched » → /t/ (après /tʃ/ sourd)."
      ],
      "reponse": "helped /t/, cleaned /d/, needed /ɪd/, watched /t/"
    },
    {
      "id": 4,

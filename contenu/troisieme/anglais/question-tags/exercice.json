    {
      "id": 1,
      "difficulte": "decouverte",
      "notion": "be",
      "enonce": "Ajoute le tag : You are tired, ___?",
      "corrige": [
        "Affirmatif avec *are* → tag négatif.",
        "« ...aren't you? »"
      ],
      "reponse": "aren't you?"
    },
    {
      "id": 2,
      "difficulte": "decouverte",
      "notion": "do",
      "enonce": "Ajoute le tag : They like music, ___?",
      "corrige": [
        "Verbe ordinaire au présent → *do* ; affirmatif → négatif.",
        "« ...don't they? »"
      ],
      "reponse": "don't they?"
    },
    {
      "id": 3,
      "difficulte": "decouverte",
      "notion": "negatif",
      "enonce": "Ajoute le tag : She isn't French, ___?",
      "corrige": [
        "Phrase négative → tag affirmatif.",
        "« ...is she? »"
      ],
      "reponse": "is she?"
    },
    {
      "id": 4,
      "difficulte": "application",
      "notion": "does",
      "enonce": "Ajoute le tag : He plays the piano, ___?",
      "corrige": [
        "Présent 3e pers. → *does* ; affirmatif → *doesn't he*.",
        "« ...doesn't he? »"
      ],
      "reponse": "doesn't he?"
    },
    {
      "id": 5,
      "difficulte": "application",
      "notion": "did",
      "enonce": "Ajoute le tag : You watched the film, ___?",
      "corrige": [
        "Prétérit ordinaire → *did* ; affirmatif → *didn't you*.",
        "« ...didn't you? »"
      ],
      "reponse": "didn't you?"
    },
    {
      "id": 6,
      "difficulte": "application",
      "notion": "modal",
      "enonce": "Ajoute le tag : She can cook, ___?",
      "corrige": [
        "Modal *can* repris ; affirmatif → *can't she*.",
        "« ...can't she? »"
      ],
      "reponse": "can't she?"
    },
    {
      "id": 7,
      "difficulte": "application",
      "notion": "am",
      "enonce": "Ajoute le tag : I am your friend, ___?",
      "corrige": [

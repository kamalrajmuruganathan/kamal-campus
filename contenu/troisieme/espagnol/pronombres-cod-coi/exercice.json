  "exercices": [
    {
      "id": 1,
      "difficulte": "decouverte",
      "notion": "cod",
      "enonce": "Remplace le COD : ¿Ves la película? Sí, ___ veo.",
      "corrige": [
        "« la película » féminin singulier, COD.",
        "→ la : Sí, la veo."
      ],
      "reponse": "Sí, la veo."
    },
    {
      "id": 2,
      "difficulte": "decouverte",
      "notion": "cod",
      "enonce": "Remplace le COD : ¿Compras los billetes? Sí, ___ compro.",
      "corrige": [
        "« los billetes » masculin pluriel, COD.",
        "→ los : Sí, los compro."
      ],
      "reponse": "Sí, los compro."
    },
    {
      "id": 3,
      "difficulte": "decouverte",
      "notion": "coi",
      "enonce": "Remplace le COI : Hablo a Juan → ___ hablo.",
      "corrige": [
        "COI singulier (a Juan).",
        "→ le : Le hablo."
      ],
      "reponse": "Le hablo."
    },
    {
      "id": 4,
      "difficulte": "application",
      "notion": "coi",
      "enonce": "Remplace le COI : Doy consejos a mis alumnos → ___ doy consejos.",
      "corrige": [
        "COI pluriel (a mis alumnos).",
        "→ les : Les doy consejos."
      ],
      "reponse": "Les doy consejos."
    },
    {
      "id": 5,
      "difficulte": "application",
      "notion": "orden",
      "enonce": "Remplace COI et COD : Ella da el libro a mí → Ella ___ ___ da.",
      "corrige": [
        "COI (me) + COD (lo).",
        "Ordre COI+COD : me lo."
      ],
      "reponse": "Ella me lo da."
    },
    {
      "id": 6,
      "difficulte": "application",
      "notion": "se",
      "enonce": "Remplace COI et COD : Doy el regalo a él → ___ ___ doy.",
      "corrige": [
        "COI « le » devient « se » devant « lo ».",
        "→ se lo doy."
      ],
      "reponse": "Se lo doy."
    },
    {
      "id": 7,
      "difficulte": "application",
      "notion": "se",
      "enonce": "Remplace : Mando las fotos a ellos → ___ ___ mando.",
      "corrige": [
        "« les » → « se » devant « las ».",
        "→ se las mando."
      ],
      "reponse": "Se las mando."
    },
    {
      "id": 8,
      "difficulte": "approfondissement",
      "notion": "infinitivo",
      "enonce": "Place les pronoms sur l'infinitif : Voy a dar el libro a ella.",
      "corrige": [
        "COI se + COD lo, collés à l'infinitif + accent.",
        "→ Voy a dárselo."
      ],
      "reponse": "Voy a dárselo."
    },
    {
      "id": 9,
      "difficulte": "approfondissement",
      "notion": "imperativo",
      "enonce": "Impératif affirmatif puis négatif : (decir la verdad a mí, tú).",
      "corrige": [
        "Affirmatif collé : dímela.",
        "Négatif avant : no me la digas."
      ],
      "reponse": "¡Dímela! / ¡No me la digas!"
    },
    {
      "id": 10,
      "difficulte": "approfondissement",
      "notion": "traduccion",
      "enonce": "Traduis : « Je le leur explique. » (el problema, a ellos)",
      "corrige": [
        "COI « les » → « se » devant « lo ».",
        "→ Se lo explico."
      ],
      "reponse": "Se lo explico."
    }
  ]

{
  "id": "3e-espagnol-indefinido-irregular-cartes",
  "chapitre": "3e-espagnol-indefinido-irregular",
  "titre": "Cartes — El pretérito indefinido irregular",
  "voie": "college",
  "niveau": "troisieme",
  "parcours": "espagnol",
  "matiere": "espagnol",
  "statut": "brouillon",
  "relu_par": null,
  "cartes": [
    {
      "recto": "Terminaisons des pretéritos fuertes (irréguliers) ?",
      "verso": "-e, -iste, -o, -imos, -isteis, -ieron (sans accent écrit)."
    },
    {
      "recto": "Radical de tener au pretérito ?",
      "verso": "tuv- : tuve, tuviste, tuvo, tuvimos, tuvisteis, tuvieron."
    },
    {
      "recto": "Radical de estar au pretérito ?",
      "verso": "estuv- : estuve, estuviste, estuvo, estuvimos…"
    },
    {
      "recto": "Comment dit-on « il a fait » (hacer) ?",
      "verso": "hizo (le c devient z devant o)."
    },
    {
      "recto": "Radical de poder et de poner ?",
      "verso": "poder → pud- ; poner → pus-."
    },
    {
      "recto": "Radical de decir et 3e pers. pluriel ?",
      "verso": "dij- ; dijeron (terminaison -eron, pas -ieron)."
    },
    {
      "recto": "Radical de venir au pretérito ?",
      "verso": "vin- : vine, viniste, vino, vinimos, vinisteis, vinieron."
    },
    {
      "recto": "Pretérito de ser et de ir ?",
      "verso": "Identique : fui, fuiste, fue, fuimos, fuisteis, fueron."
    },
    {
      "recto": "Pretérito de dar ?",
      "verso": "di, diste, dio, dimos, disteis, dieron (terminaisons de -er/-ir)."
    },
    {
      "recto": "Radical de querer et de saber ?",
      "verso": "querer → quis- ; saber → sup-."
    },
    {
      "recto": "Particularité des radicaux en -j (dij-, traj-) ?",
      "verso": "3e personne du pluriel en -eron : dijeron, trajeron."
    },
    {
      "recto": "Traduis : « Ayer tuve que estudiar. »",
      "verso": "Hier, j'ai dû étudier."
    }
  ]
}
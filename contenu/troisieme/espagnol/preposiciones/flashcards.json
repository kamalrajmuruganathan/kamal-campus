  "cartes": [
    {
      "recto": "Emplois de la préposition *a* ?",
      "verso": "Direction, destinataire, et le *a personnel* devant un COD humain."
    },
    {
      "recto": "Qu'est-ce que le *a personnel* ?",
      "verso": "Le *a* obligatoire devant un COD = personne : *Veo **a** María.*"
    },
    {
      "recto": "Emplois de *en* ?",
      "verso": "Lieu (position), temps (mois/année), moyen de transport."
    },
    {
      "recto": "Traduis : à la maison.",
      "verso": "**en** casa (position, sans mouvement)."
    },
    {
      "recto": "Traduis : en train.",
      "verso": "**en** tren."
    },
    {
      "recto": "Emplois de *de* ?",
      "verso": "Possession, origine, matière."
    },
    {
      "recto": "Traduis : Je suis du Mexique.",
      "verso": "Soy **de** México."
    },
    {
      "recto": "Traduis : une table en bois.",
      "verso": "una mesa **de** madera."
    },
    {
      "recto": "Que signifie *con* ?",
      "verso": "« avec » : *Voy **con** mis amigos.*"
    },
    {
      "recto": "« avec moi » et « avec toi » ?",
      "verso": "**conmigo** et **contigo**."
    },
    {
      "recto": "Corrige : *Veo María.*",
      "verso": "Faux → Veo **a** María (a personnel)."
    },
    {
      "recto": "*a* ou *en* ? La différence ?",
      "verso": "*a* = mouvement/direction ; *en* = position."
    }
  ]
}
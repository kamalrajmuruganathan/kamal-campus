{
  "id": "3e-espagnol-preposiciones-exos",
  "chapitre": "3e-espagnol-preposiciones",
  "titre": "Exercices — Les prépositions (a, en, de, con…)",
  "voie": "college",
  "niveau": "troisieme",
  "parcours": "espagnol",
  "matiere": "espagnol",
  "statut": "brouillon",
  "relu_par": null,
  "consigne": "Cherche chaque exercice au brouillon avant d'ouvrir le corrigé.",
  "exercices": [
    {
      "id": 1,
      "difficulte": "decouverte",
      "notion": "a-direccion",
      "enonce": "Complète : Voy ___ el cine.",
      "corrige": [
        "Direction → *a*.",
        "Voy **a** el cine → **al** cine."
      ],
      "reponse": "Voy al cine."
    },
    {
      "id": 2,
      "difficulte": "decouverte",
      "notion": "en-lugar",
      "enonce": "Complète : Estamos ___ el colegio.",
      "corrige": [
        "Position → *en*.",
        "Estamos **en** el colegio."
      ],
      "reponse": "Estamos en el colegio."
    },
    {
      "id": 3,
      "difficulte": "decouverte",
      "notion": "de-posesion",
      "enonce": "Complète : Es la casa ___ mis abuelos.",
      "corrige": [
        "Possession → *de*.",
        "Es la casa **de** mis abuelos."
      ],
      "reponse": "Es la casa de mis abuelos."
    },
    {
      "id": 4,
      "difficulte": "application",
      "notion": "a-personal",
      "enonce": "Complète avec le *a personnel* : Veo ___ mi profesor.",
      "corrige": [
        "COD personne → *a* obligatoire.",
        "Veo **a** mi profesor."
      ],
      "reponse": "Veo a mi profesor."
    },
    {
      "id": 5,
      "difficulte": "application",
      "notion": "en-transporte",
      "enonce": "Traduis : Je voyage en avion.",
      "corrige": [
        "Transport → *en avión*.",
        "**Viajo en avión.**"
      ],
      "reponse": "Viajo en avión."
    },
    {
      "id": 6,
      "difficulte": "application",
      "notion": "con",
      "enonce": "Traduis : Je sors avec toi.",
      "corrige": [
        "« avec toi » = *contigo*.",
        "**Salgo contigo.**"
      ],
      "reponse": "Salgo contigo."
    },
    {
      "id": 7,
      "difficulte": "application",
      "notion": "de-origen",
      "enonce": "Traduis : Nous sommes d'Espagne.",
      "corrige": [
        "Origine → *de España*.",
        "**Somos de España.**"
      ],
      "reponse": "Somos de España."
    },
    {
      "id": 8,
      "difficulte": "approfondissement",
      "notion": "repere-erreur",
      "enonce": "Corrige : Escucho a la radio.",
      "corrige": [
        "*la radio* n'est pas une personne : pas de *a personnel*.",
        "Escucho **la** radio."
      ],
      "reponse": "Escucho la radio."
    },
    {
      "id": 9,
      "difficulte": "approfondissement",
      "notion": "choix",
      "enonce": "Complète : Escribo ___ mi amiga ___ su cumpleaños.",
      "corrige": [
        "Destinataire → *a* ; temps (le jour de) → *en*/*para*… ici *para*/*en* ; on garde *para*.",
        "Escribo **a** mi amiga **para** su cumpleaños."
      ],
      "reponse": "Escribo a mi amiga para su cumpleaños."
    },
    {
      "id": 10,
      "difficulte": "approfondissement",
      "notion": "synthese",
      "enonce": "Traduis : Je vais à Madrid en train avec mes amis.",
      "corrige": [
        "Direction *a*, transport *en*, accompagnement *con*.",
        "**Voy a Madrid en tren con mis amigos.**"
      ],
      "reponse": "Voy a Madrid en tren con mis amigos."
    }
  ]
}
      "recto": "Pluriel de « das Buch » ?",
      "verso": "die Bücher (u → ü + -er)."
    },
    {
      "recto": "Pluriel de « der Baum » ?",
      "verso": "die Bäume (a → äu)."
    },
    {
      "recto": "Comparatif de « alt » ?",
      "verso": "älter (a → ä + -er)."
    },
    {
      "recto": "Comparatif de « groß » ?",
      "verso": "größer (o → ö + -er)."
    },
    {
      "recto": "Quand écrit-on « ß » ?",
      "verso": "Après une voyelle longue ou une diphtongue : Straße, Fuß."
    },
    {
      "recto": "Quand écrit-on « ss » ?",
      "verso": "Après une voyelle courte : Wasser, muss, Fluss."
    },
    {
      "recto": "« ch » après a, o, u, au ?",
      "verso": "« ach-Laut » : Buch, Nacht, auch."
    },
    {
      "recto": "« ch » après e, i, consonne ?",
      "verso": "« ich-Laut » : ich, nicht, Milch."
    },
    {
      "recto": "Combien de sons note « sch » ?",
      "verso": "Un seul son (Schule, Fisch)."
    },
    {
      "recto": "Où tombe l'accent dans un mot simple ?",
      "verso": "Sur la première syllabe : LEH-rer, AP-fel."
    },
    {
      "recto": "Préfixe séparable / inséparable et accent ?",
      "verso": "Séparable = accentué (AUF-stehen) ; inséparable = non accentué (ver-STE-hen)."
    },
    {
      "recto": "Accent des verbes en -ieren ?",
      "verso": "Sur -ier- : stu-DIE-ren, tele-fo-NIE-ren."
    }

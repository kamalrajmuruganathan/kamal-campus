  "consigne": "Cherche chaque exercice au brouillon avant d'ouvrir le corrigé.",
  "exercices": [
    {
      "id": 1,
      "difficulte": "decouverte",
      "notion": "vocabulaire",
      "enonce": "Traduis en anglais : « le pain ».",
      "corrige": [
        "« le pain » se dit *bread*.",
        "bread"
      ],
      "reponse": "bread"
    },
    {
      "id": 2,
      "difficulte": "decouverte",
      "notion": "traduction-fr",
      "enonce": "Que veut dire le mot anglais *cheese* ?",
      "corrige": [
        "*cheese* = le fromage."
      ],
      "reponse": "le fromage"
    },
    {
      "id": 3,
      "difficulte": "application",
      "notion": "a-an",
      "enonce": "Complète avec *a* ou *an* : ___ egg.",
      "corrige": [
        "*egg* commence par un son voyelle.",
        "Devant un son voyelle, on dit *an* : **an** egg."
      ],
      "reponse": "an egg"
    },
    {
      "id": 4,
      "difficulte": "application",
      "notion": "a-an",
      "enonce": "Complète avec *a* ou *an* : ___ banana.",
      "corrige": [
        "*banana* commence par le son « b », ce n'est pas un son voyelle.",
        "On dit donc *a* : **a** banana."
      ],
      "reponse": "a banana"
    },
    {
      "id": 5,
      "difficulte": "application",
      "notion": "eat-drink",
      "enonce": "Complète avec *eat* ou *drink* : I ___ water.",
      "corrige": [
        "L'eau (*water*) se boit.",
        "boire = *drink* : I **drink** water."
      ],
      "reponse": "I drink water."
    },
    {
      "id": 6,
      "difficulte": "application",
      "notion": "eat-drink",
      "enonce": "Complète avec *eat* ou *drink* : I ___ bread.",
      "corrige": [
        "Le pain (*bread*) se mange.",
        "manger = *eat* : I **eat** bread."
      ],
      "reponse": "I eat bread."
    },
    {
      "id": 7,
      "difficulte": "application",
      "notion": "categorie",
      "enonce": "Trouve l'intrus (ce n'est pas une boisson) : water, milk, cheese, juice.",
      "corrige": [
        "*water* (l'eau), *milk* (le lait) et *juice* (le jus) se boivent.",
        "*cheese* (le fromage) se mange."
      ],
      "reponse": "cheese"
    },
    {
      "id": 8,
      "difficulte": "approfondissement",
      "notion": "phrase",
      "enonce": "Traduis : « Je bois du jus. »",
      "corrige": [
        "« Je bois » = *I drink*.",
        "« du jus » = *juice*.",
        "I drink juice."
      ],
      "reponse": "I drink juice."
    },
    {
      "id": 9,
      "difficulte": "approfondissement",
      "notion": "phrase",
      "enonce": "Traduis : « J'aime le poisson. »",
      "corrige": [
        "« J'aime » = *I like*.",
        "« le poisson » = *fish*.",
        "I like fish."
      ],
      "reponse": "I like fish."
    },
    {
      "id": 10,
      "difficulte": "approfondissement",
      "notion": "comprehension",
      "enonce": "Lis : « I eat an apple. I drink water. » Que mange l'enfant ? Que boit-il ?",
      "corrige": [
        "*I eat an apple* = je mange une pomme.",
        "*I drink water* = je bois de l'eau."
      ],
      "reponse": "Il mange une pomme et il boit de l'eau."
    }
  ]
}
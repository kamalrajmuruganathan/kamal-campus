  "consigne": "Cherche chaque exercice au brouillon avant d'ouvrir le corrigé.",
  "exercices": [
    {
      "id": 1,
      "difficulte": "decouverte",
      "notion": "vocabulaire",
      "enonce": "Traduis en anglais : « le frère ».",
      "corrige": [
        "« le frère » se dit *brother*.",
        "brother"
      ],
      "reponse": "brother"
    },
    {
      "id": 2,
      "difficulte": "decouverte",
      "notion": "traduction-fr",
      "enonce": "Que veut dire *grandma* ?",
      "corrige": [
        "*grandma* est le mot de la maison pour *grandmother*.",
        "*grandma* = mamie (la grand-mère)."
      ],
      "reponse": "mamie (la grand-mère)"
    },
    {
      "id": 3,
      "difficulte": "application",
      "notion": "vocabulaire",
      "enonce": "Traduis en anglais : « la tante » et « l'oncle ».",
      "corrige": [
        "« la tante » = *aunt*.",
        "« l'oncle » = *uncle*."
      ],
      "reponse": "aunt, uncle"
    },
    {
      "id": 4,
      "difficulte": "application",
      "notion": "garcon-fille",
      "enonce": "Tom est un garçon. Pour sa sœur Lisa, Tom est-il son *brother* ou sa *sister* ?",
      "corrige": [
        "Un garçon est un *brother* (frère), une fille est une *sister* (sœur).",
        "Tom est le *brother* de Lisa."
      ],
      "reponse": "brother"
    },
    {
      "id": 5,
      "difficulte": "application",
      "notion": "garcon-fille",
      "enonce": "Trouve le mot qui va avec, pour une femme : father → ___ ; grandfather → ___.",
      "corrige": [
        "*father* (le père) → *mother* (la mère).",
        "*grandfather* (le grand-père) → *grandmother* (la grand-mère)."
      ],
      "reponse": "mother, grandmother"
    },
    {
      "id": 6,
      "difficulte": "application",
      "notion": "presenter",
      "enonce": "Complète : This is my ___ . (ma sœur)",
      "corrige": [
        "« ma sœur » = *my sister*.",
        "This is my **sister**."
      ],
      "reponse": "This is my sister."
    },
    {
      "id": 7,
      "difficulte": "application",
      "notion": "garcon-fille",
      "enonce": "Trouve l'intrus (ce n'est pas une femme ou une fille) : mum, sister, aunt, uncle.",
      "corrige": [
        "*mum*, *sister* et *aunt* sont des femmes ou des filles.",
        "*uncle* (l'oncle) est un homme."
      ],
      "reponse": "uncle"
    },
    {
      "id": 8,
      "difficulte": "approfondissement",
      "notion": "presenter",
      "enonce": "Traduis : « Voici mon papa. »",
      "corrige": [
        "« Voici » = *This is*.",
        "« mon papa » = *my dad*.",
        "This is my dad."
      ],
      "reponse": "This is my dad."
    },
    {
      "id": 9,
      "difficulte": "approfondissement",
      "notion": "ordre-des-mots",
      "enonce": "Remets les mots dans l'ordre : love / family / I / my",
      "corrige": [
        "On commence par *I* (je), puis le verbe *love* (aime).",
        "I love my family. (J'aime ma famille.)"
      ],
      "reponse": "I love my family."
    },
    {
      "id": 10,
      "difficulte": "approfondissement",
      "notion": "comprehension",
      "enonce": "Lis : « This is my family. This is my mum, my dad and my brother. » Qui sont les trois personnes présentées ?",
      "corrige": [
        "*mum* = maman, *dad* = papa, *brother* = le frère.",
        "Ce sont la maman, le papa et le frère."
      ],
      "reponse": "la maman, le papa et le frère"
    }
  ]
}
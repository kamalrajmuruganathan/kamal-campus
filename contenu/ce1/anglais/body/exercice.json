  "statut": "brouillon",
  "relu_par": null,
  "consigne": "Cherche chaque exercice au brouillon avant d'ouvrir le corrigé.",
  "exercices": [
    {
      "id": 1,
      "difficulte": "decouverte",
      "notion": "vocabulaire",
      "enonce": "Traduis en anglais : « la tête ».",
      "corrige": [
        "« la tête » se dit *head*.",
        "head"
      ],
      "reponse": "head"
    },
    {
      "id": 2,
      "difficulte": "decouverte",
      "notion": "traduction-fr",
      "enonce": "Que veut dire le mot anglais *nose* ?",
      "corrige": [
        "*nose* est une partie du visage.",
        "*nose* = le nez."
      ],
      "reponse": "le nez"
    },
    {
      "id": 3,
      "difficulte": "decouverte",
      "notion": "categorie",
      "enonce": "Trouve l'intrus (ce n'est pas une partie de la tête) : eyes, nose, leg, mouth.",
      "corrige": [
        "*eyes* (les yeux), *nose* (le nez) et *mouth* (la bouche) sont sur la tête.",
        "*leg* (la jambe) n'est pas sur la tête."
      ],
      "reponse": "leg"
    },
    {
      "id": 4,
      "difficulte": "application",
      "notion": "vocabulaire",
      "enonce": "*hair* ou *head* : quel mot veut dire « les cheveux » ?",
      "corrige": [
        "*head* = la tête.",
        "*hair* = les cheveux."
      ],
      "reponse": "hair"
    },
    {
      "id": 5,
      "difficulte": "application",
      "notion": "pluriel",
      "enonce": "Écris le pluriel de *eye* (un œil).",
      "corrige": [
        "Pour la plupart des mots, on ajoute **-s** au pluriel.",
        "*eye* → *eyes*."
      ],
      "reponse": "eyes"
    },
    {
      "id": 6,
      "difficulte": "application",
      "notion": "phrase",
      "enonce": "Complète : I hear with my ___ . (mes oreilles)",
      "corrige": [
        "On entend avec les oreilles : *ears*.",
        "I hear with my **ears**."
      ],
      "reponse": "I hear with my ears."
    },
    {
      "id": 7,
      "difficulte": "application",
      "notion": "traduction-fr",
      "enonce": "Traduis en français : *arm*, *leg*, *knee*.",
      "corrige": [
        "*arm* = le bras, *leg* = la jambe, *knee* = le genou."
      ],
      "reponse": "le bras, la jambe, le genou"
    },
    {
      "id": 8,
      "difficulte": "approfondissement",
      "notion": "pluriel",
      "enonce": "Écris le pluriel de *foot* (un pied) et de *tooth* (une dent).",
      "corrige": [
        "Ces deux mots ont un pluriel spécial : on ne met pas de -s.",
        "*foot* → *feet* ; *tooth* → *teeth*."
      ],
      "reponse": "feet, teeth"
    },
    {
      "id": 9,
      "difficulte": "approfondissement",
      "notion": "ordre-des-mots",
      "enonce": "Remets les mots dans l'ordre : my / I / with / see / eyes",
      "corrige": [
        "La phrase commence par *I* (je), puis le verbe *see* (vois).",
        "I see with my eyes. (Je vois avec mes yeux.)"
      ],
      "reponse": "I see with my eyes."
    },
    {
      "id": 10,
      "difficulte": "approfondissement",
      "notion": "phrase",
      "enonce": "Traduis : « J'ai dix doigts. »",
      "corrige": [
        "« J'ai » = *I have*, « dix » = *ten*.",
        "« les doigts » = *fingers* (pluriel avec -s).",
        "I have ten fingers."
      ],
      "reponse": "I have ten fingers."
    }
  ]
}
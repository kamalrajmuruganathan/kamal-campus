{
  "id": "ce1-francais-singulier-pluriel-cartes",
  "chapitre": "ce1-francais-singulier-pluriel",
  "titre": "Cartes — Le singulier et le pluriel des noms",
  "voie": "primaire",
  "niveau": "ce1",
  "parcours": "francais",
  "matiere": "francais",
  "statut": "brouillon",
  "relu_par": null,
  "cartes": [
    {
      "recto": "Que veut dire singulier ?",
      "verso": "Il y a un seul être ou une seule chose : un chat."
    },
    {
      "recto": "Que veut dire pluriel ?",
      "verso": "Il y a plusieurs êtres ou choses : des chats."
    },
    {
      "recto": "Que met-on à la fin d'un nom au pluriel ?",
      "verso": "On ajoute presque toujours un -s."
    },
    {
      "recto": "Petits mots du singulier ?",
      "verso": "le, la, un, une."
    },
    {
      "recto": "Petits mots du pluriel ?",
      "verso": "les, des."
    },
    {
      "recto": "Pluriel de « chat » ?",
      "verso": "des chats."
    },
    {
      "recto": "Pluriel de « fleur » ?",
      "verso": "des fleurs."
    },
    {
      "recto": "Pluriel de « souris » ?",
      "verso": "des souris (ça ne change pas)."
    },
    {
      "recto": "Entend-on le -s du pluriel quand on parle ?",
      "verso": "Non, souvent on ne l'entend pas, mais il faut l'écrire."
    },
    {
      "recto": "Les noms en -s, -x, -z au pluriel ?",
      "verso": "Ils ne changent pas : une souris → des souris."
    },
    {
      "recto": "« les chiens » : singulier ou pluriel ?",
      "verso": "Pluriel."
    },
    {
      "recto": "« une pomme » : singulier ou pluriel ?",
      "verso": "Singulier."
    }
  ]
}
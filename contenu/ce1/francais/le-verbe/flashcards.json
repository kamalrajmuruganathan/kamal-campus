{
  "id": "ce1-francais-le-verbe-cartes",
  "chapitre": "ce1-francais-le-verbe",
  "titre": "Cartes — Le verbe et son infinitif",
  "voie": "primaire",
  "niveau": "ce1",
  "parcours": "francais",
  "matiere": "francais",
  "statut": "brouillon",
  "relu_par": null,
  "cartes": [
    {
      "recto": "Qu'est-ce qu'un verbe ?",
      "verso": "Un mot qui dit une action (courir) ou un état (être)."
    },
    {
      "recto": "Comment trouver le verbe ?",
      "verso": "On demande : Qu'est-ce qu'on fait ?"
    },
    {
      "recto": "Qu'est-ce que l'infinitif ?",
      "verso": "C'est le nom du verbe, celui du dictionnaire : manger, finir."
    },
    {
      "recto": "Comment trouver l'infinitif ?",
      "verso": "On dit : il faut… (il faut manger → manger)."
    },
    {
      "recto": "Infinitif de « mange » ?",
      "verso": "manger"
    },
    {
      "recto": "Infinitif de « finis » ?",
      "verso": "finir"
    },
    {
      "recto": "Infinitif de « prends » ?",
      "verso": "prendre"
    },
    {
      "recto": "Infinitif de « est » (il est) ?",
      "verso": "être"
    },
    {
      "recto": "Infinitif de « a » (il a) ?",
      "verso": "avoir"
    },
    {
      "recto": "Le verbe change-t-il dans la phrase ?",
      "verso": "Oui : je mange, tu manges, nous mangeons."
    },
    {
      "recto": "L'infinitif change-t-il ?",
      "verso": "Non, il reste toujours pareil."
    },
    {
      "recto": "Par quoi finissent souvent les infinitifs ?",
      "verso": "Par -er, -ir, -re ou -oir."
    }
  ]
}
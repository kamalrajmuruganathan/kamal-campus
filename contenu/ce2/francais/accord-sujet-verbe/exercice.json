  "exercices": [
    {
      "id": 1,
      "difficulte": "decouverte",
      "notion": "sujet",
      "enonce": "Souligne le sujet : « Le chien dort. »",
      "corrige": [
        "Pose la question : qui est-ce qui dort ?",
        "Le sujet est « Le chien »."
      ],
      "reponse": "Le chien"
    },
    {
      "id": 2,
      "difficulte": "decouverte",
      "notion": "accord",
      "enonce": "Complète : « Je ___ (chanter). »",
      "corrige": [
        "Avec « je », le verbe en -er prend -e.",
        "« Je chante »."
      ],
      "reponse": "Je chante"
    },
    {
      "id": 3,
      "difficulte": "decouverte",
      "notion": "accord",
      "enonce": "Complète : « Ils ___ (jouer). »",
      "corrige": [
        "Avec « ils », le verbe en -er prend -ent.",
        "« Ils jouent »."
      ],
      "reponse": "Ils jouent"
    },
    {
      "id": 4,
      "difficulte": "application",
      "notion": "accord",
      "enonce": "Mets au pluriel : « L'oiseau chante. » → « Les oiseaux ___ . »",
      "corrige": [
        "Sujet pluriel → verbe en -ent.",
        "« Les oiseaux chantent »."
      ],
      "reponse": "Les oiseaux chantent"
    },
    {
      "id": 5,
      "difficulte": "application",
      "notion": "accord",
      "enonce": "Complète : « Nous ___ (manger) une pomme. »",
      "corrige": [
        "Avec « nous », le verbe prend -ons.",
        "« Nous mangeons »."
      ],
      "reponse": "Nous mangeons"
    },
    {
      "id": 6,
      "difficulte": "application",
      "notion": "accord",
      "enonce": "Complète : « Vous ___ (parler) fort. »",
      "corrige": [
        "Avec « vous », le verbe prend -ez.",
        "« Vous parlez »."
      ],
      "reponse": "Vous parlez"
    },
    {
      "id": 7,
      "difficulte": "application",
      "notion": "sujet",
      "enonce": "Trouve le sujet : « Dans le ciel, les nuages passent. »",
      "corrige": [
        "Qui est-ce qui passe ?",
        "Le sujet est « les nuages »."
      ],
      "reponse": "les nuages"
    },

      "id": 8,
      "difficulte": "approfondissement",
      "notion": "accord",
      "enonce": "Corrige : « Les enfants joue dans la cour. »",
      "corrige": [
        "Sujet pluriel « les enfants » → verbe -ent.",
        "« Les enfants jouent dans la cour. »"
      ],
      "reponse": "Les enfants jouent dans la cour."
    },
    {
      "id": 9,
      "difficulte": "approfondissement",
      "notion": "accord",
      "enonce": "Complète : « Léa et Tom ___ (finir) leur travail. »",
      "corrige": [
        "Deux sujets = ils. Le verbe finir donne « finissent ».",
        "« Léa et Tom finissent leur travail. »"
      ],
      "reponse": "Léa et Tom finissent leur travail."
    },

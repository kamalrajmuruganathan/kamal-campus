      "verso": "jeune / vieux"
    },
    {
      "recto": "Accord de l'adjectif",
      "verso": "masculin -o (alto), féminin -a (alta)"
    },
    {
      "recto": "avere : io / lui",
      "verso": "ho / ha"
    },

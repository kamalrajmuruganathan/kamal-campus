      "enonce": "Traduis trois traits de caractère : gentil, drôle, calme.",
      "corrige": [
        "gentil → nett.",
        "drôle → lustig.",
        "calme → ruhig."
      ],
      "reponse": "nett, lustig, ruhig"
    },

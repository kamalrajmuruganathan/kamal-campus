  "exercices": [
    {
      "id": 1,
      "difficulte": "decouverte",
      "notion": "sein",
      "enonce": "Conjugue « sein » : ich …, du …, er … .",
      "corrige": [
        "ich bin.",
        "du bist.",
        "er ist."
      ],
      "reponse": "ich bin, du bist, er ist"
    },
    {
      "id": 2,
      "difficulte": "decouverte",
      "notion": "haben",
      "enonce": "Conjugue « haben » : ich …, du …, sie … .",
      "corrige": [
        "ich habe.",
        "du hast.",
        "sie hat."
      ],
      "reponse": "ich habe, du hast, sie hat"
    },
    {
      "id": 3,
      "difficulte": "application",
      "notion": "vocabulaire",
      "enonce": "Traduis : grand, petit, jeune, vieux.",
      "corrige": [
        "grand → groß, petit → klein.",
        "jeune → jung, vieux → alt."
      ],
      "reponse": "groß, klein, jung, alt"
    },
    {
      "id": 4,
      "difficulte": "application",
      "notion": "traduction",
      "enonce": "Traduis : « Il est petit et jeune. »",
      "corrige": [
        "Utiliser sein (ist).",
        "Er ist klein und jung."
      ],
      "reponse": "Er ist klein und jung."
    },
    {
      "id": 5,
      "difficulte": "application",
      "notion": "haben",
      "enonce": "Traduis : « Elle a les cheveux blonds. »",
      "corrige": [
        "Utiliser haben (hat).",
        "Adjectif au pluriel : blonde Haare.",
        "Sie hat blonde Haare."
      ],
      "reponse": "Sie hat blonde Haare."
    },
    {
      "id": 6,
      "difficulte": "application",
      "notion": "haben",
      "enonce": "Traduis : « J'ai les yeux verts. »",
      "corrige": [
        "Utiliser haben (habe).",
        "grüne Augen (pluriel).",
        "Ich habe grüne Augen."
      ],
      "reponse": "Ich habe grüne Augen."
    },
    {
      "id": 7,

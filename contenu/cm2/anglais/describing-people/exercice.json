      "notion": "vocabulaire",
      "enonce": "Traduis : grand, petit, jeune, vieux.",
      "corrige": [
        "Quatre adjectifs de description.",
        "tall = grand, short = petit",
        "young = jeune, old = vieux"
      ],
      "reponse": "tall, short, young, old"
    },
    {
      "id": 2,
      "difficulte": "decouverte",
      "notion": "have-got",
      "enonce": "Complète avec have ou has got : I ___ got brown hair. She ___ got blue eyes.",
      "corrige": [
        "I → have got ; she → has got.",
        "I have got brown hair. She has got blue eyes."
      ],
      "reponse": "I have got brown hair. She has got blue eyes."
    },
    {
      "id": 3,
      "difficulte": "application",
      "notion": "be",
      "enonce": "Complète avec is ou are : He ___ tall. They ___ young.",
      "corrige": [
        "he → is ; they → are.",
        "He is tall. They are young."
      ],
      "reponse": "He is tall. They are young."
    },
    {
      "id": 4,
      "difficulte": "application",
      "notion": "caractere",
      "enonce": "Traduis : Mon ami est gentil et drôle.",
      "corrige": [
        "gentil = kind, drôle = funny",
        "My friend is kind and funny."
      ],
      "reponse": "My friend is kind and funny."
    },
    {
      "id": 5,
      "difficulte": "application",
      "notion": "possessif",
      "enonce": "Complète avec his ou her : This is Tom and this is ___ dog. This is Anna and this is ___ cat.",
      "corrige": [
        "Tom (garçon) → his ; Anna (fille) → her.",
        "his dog / her cat"
      ],
      "reponse": "his dog / her cat"
    },
    {
      "id": 6,
      "difficulte": "application",
      "notion": "place-adjectif",
      "enonce": "Remets dans l'ordre : boy / a / tall.",
      "corrige": [
        "L'adjectif va avant le nom.",
        "a tall boy"

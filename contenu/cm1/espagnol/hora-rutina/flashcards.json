      "verso": "desayunar → desayuno"
    },
    {
      "recto": "aller à l'école",
      "verso": "ir al colegio → voy al colegio"
    },
    {
      "recto": "se coucher (je me couche)",
      "verso": "acostarse → me acuesto"
    },

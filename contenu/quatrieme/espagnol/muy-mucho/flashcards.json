{
  "id": "4e-espagnol-muy-mucho-cartes",
  "chapitre": "4e-espagnol-muy-mucho",
  "titre": "Cartes — Muy et mucho",
  "voie": "college",
  "niveau": "quatrieme",
  "parcours": "espagnol",
  "matiere": "espagnol",
  "statut": "brouillon",
  "relu_par": null,
  "cartes": [
    {
      "recto": "Quand emploie-t-on *muy* ?",
      "verso": "Devant un adjectif ou un adverbe. *muy alto, muy bien.*"
    },
    {
      "recto": "*Muy* s'accorde-t-il ?",
      "verso": "Non, jamais : *muy alta, muy altos*."
    },
    {
      "recto": "*Mucho* devant un nom : que fait-il ?",
      "verso": "Il s'accorde : mucho/mucha/muchos/muchas."
    },
    {
      "recto": "*Mucho* après un verbe : que fait-il ?",
      "verso": "Il reste invariable (adverbe) : *Trabaja mucho*."
    },
    {
      "recto": "Peut-on dire *muy mucho* ?",
      "verso": "Non, cela n'existe pas."
    },
    {
      "recto": "Traduis : très fatigué.",
      "verso": "**muy** cansado."
    },
    {
      "recto": "Traduis : beaucoup d'eau.",
      "verso": "**mucha** agua."
    },
    {
      "recto": "Traduis : beaucoup de livres.",
      "verso": "**muchos** libros."
    },
    {
      "recto": "Traduis : Il travaille beaucoup.",
      "verso": "Trabaja **mucho**."
    },
    {
      "recto": "*muy* ou *mucho* ? ___ dinero.",
      "verso": "**mucho** dinero (devant un nom)."
    },
    {
      "recto": "*muy* ou *mucho* ? Es ___ inteligente.",
      "verso": "**muy** inteligente (devant un adjectif)."
    },
    {
      "recto": "Comment dit-on « énormément » ?",
      "verso": "**muchísimo** : *Me gustó muchísimo.*"
    }
  ]
}
{
  "id": "4e-anglais-preterit-vs-present-perfect-cartes",
  "chapitre": "4e-anglais-preterit-vs-present-perfect",
  "titre": "Cartes — Prétérit ou present perfect ?",
  "voie": "college",
  "niveau": "quatrieme",
  "parcours": "anglais",
  "matiere": "anglais",
  "statut": "brouillon",
  "relu_par": null,
  "cartes": [
    {
      "recto": "Quand emploie-t-on le prétérit ?",
      "verso": "Pour une action passée **terminée et datée**. Ex. : I **saw** it yesterday."
    },
    {
      "recto": "Quand emploie-t-on le present perfect ?",
      "verso": "Pour un **lien avec le présent** (expérience, bilan). Ex. : I **have seen** it."
    },
    {
      "recto": "Peut-on dire « I have seen him yesterday » ?",
      "verso": "Non ! « yesterday » impose le prétérit : « I **saw** him yesterday »."
    },
    {
      "recto": "Mots-signaux du prétérit ?",
      "verso": "yesterday, last week, ago, in 2020, when I was young."
    },
    {
      "recto": "Mots-signaux du present perfect ?",
      "verso": "ever, never, already, yet, just."
    },
    {
      "recto": "Question au prétérit ?",
      "verso": "**did** + base verbale. Ex. : **Did** you **go**...?"
    },
    {
      "recto": "Question au present perfect ?",
      "verso": "**have/has** + sujet + participe passé. Ex. : **Have** you **seen**...?"
    },
    {
      "recto": "Prétérit de « go » ?",
      "verso": "**went**. Participe passé : **gone**."
    },
    {
      "recto": "Après « I have », prétérit ou participe passé ?",
      "verso": "Le **participe passé**. Ex. : I have **seen** (pas *saw*)."
    },
    {
      "recto": "Traduis « Nous venons d'arriver. »",
      "verso": "We **have just arrived**."
    },
    {
      "recto": "Traduis « Elle est allée en Italie en 2019. »",
      "verso": "She **went** to Italy in 2019 (date → prétérit)."
    },
    {
      "recto": "« J'ai vu ce film hier » se traduit par ?",
      "verso": "I **saw** that film yesterday (prétérit, car moment précis)."
    }
  ]
}
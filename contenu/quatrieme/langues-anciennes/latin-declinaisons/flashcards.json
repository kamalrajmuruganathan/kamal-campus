      "recto": "Génitif singulier des trois premières déclinaisons ?",
      "verso": "1re : -ae ; 2e : -i ; 3e : -is."
    },
    {
      "recto": "Décline dominus au singulier (NVA + gén.).",
      "verso": "dominus, domine, dominum, domini."
    },
    {
      "recto": "Décline rex, regis au singulier.",
      "verso": "rex, regem, regis, regi, rege."
    },
    {
      "recto": "Radical de rex, regis ?",
      "verso": "reg- (pris dans le génitif regis)."
    },
    {
      "recto": "Règle des noms neutres ?",
      "verso": "Nominatif = Vocatif = Accusatif ; pluriel en -a (templa)."
    },
    {
      "recto": "Génitif pluriel de dominus ?",
      "verso": "dominorum."
    },
    {
      "recto": "Datif/ablatif pluriel de la 3e déclinaison ?",
      "verso": "-ibus (regibus)."
    },
    {
      "recto": "Nominatif pluriel de rex, regis ?",
      "verso": "reges."
    },
    {
      "recto": "Vocatif singulier de dominus ?",
      "verso": "domine (« ô maître »)."
    },
    {
      "recto": "Que veut dire « rex, regis » ?",
      "verso": "Le roi (masculin, 3e déclinaison)."
    },
    {
      "recto": "Que veut dire « templum, templi » ?",
      "verso": "Le temple (neutre, 2e déclinaison)."
    },
    {
      "recto": "Comment trouve-t-on la déclinaison d'un nom ?",
      "verso": "Par la terminaison de son génitif singulier."
    }

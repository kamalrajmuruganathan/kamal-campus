  "titre": "Cartes — Latin : imparfait et parfait de l'indicatif",
  "voie": "college",
  "niveau": "quatrieme",
  "parcours": "langues-anciennes",
  "matiere": "langues-anciennes",
  "statut": "brouillon",
  "relu_par": null,
  "cartes": [
    {
      "recto": "Caractéristique de l'imparfait ?",
      "verso": "La syllabe -ba- : amabam, amabas, amabat…"
    },
    {
      "recto": "Conjugue amare à l'imparfait.",
      "verso": "amabam, amabas, amabat, amabamus, amabatis, amabant."
    },
    {
      "recto": "Imparfait de esse ?",
      "verso": "eram, eras, erat, eramus, eratis, erant."
    },
    {
      "recto": "Terminaisons du parfait ?",
      "verso": "-i, -isti, -it, -imus, -istis, -erunt."
    },
    {
      "recto": "Conjugue amare au parfait.",
      "verso": "amavi, amavisti, amavit, amavimus, amavistis, amaverunt."
    },
    {
      "recto": "Parfait de esse ?",
      "verso": "fui, fuisti, fuit, fuimus, fuistis, fuerunt."
    },
    {
      "recto": "« J'aimais » vs « j'ai aimé » ?",
      "verso": "amabam (imparfait) / amavi (parfait)."
    },
    {
      "recto": "Valeur de l'imparfait ?",
      "verso": "Action qui dure, se répète, décrit l'arrière-plan."
    },
    {
      "recto": "Valeur du parfait ?",
      "verso": "Action achevée, ponctuelle, qui fait avancer le récit."
    },
    {
      "recto": "3e personne pluriel du parfait de amare ?",
      "verso": "amaverunt (terminaison -erunt, pas -ant)."
    },
    {
      "recto": "Radical du parfait de esse ?",
      "verso": "fu- (fui, fuisti, fuit…)."
    },
    {
      "recto": "« Il était » vs « il fut » ?",
      "verso": "erat (imparfait) / fuit (parfait)."
    }
  ]
}
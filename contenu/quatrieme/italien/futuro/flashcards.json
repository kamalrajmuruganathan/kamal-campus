{
  "id": "4e-italien-futuro-cartes",
  "chapitre": "4e-italien-futuro",
  "titre": "Cartes — Il futuro semplice",
  "voie": "college",
  "niveau": "quatrieme",
  "parcours": "italien",
  "matiere": "italien",
  "statut": "brouillon",
  "relu_par": null,
  "cartes": [
    {
      "recto": "À quoi sert le futuro semplice ?",
      "verso": "À exprimer une action à venir, une prévision ou une hypothèse."
    },
    {
      "recto": "Terminaisons du futur ?",
      "verso": "-erò, -erai, -erà, -eremo, -erete, -eranno (et -irò… pour les -ire)."
    },
    {
      "recto": "Que devient le -a- des verbes en -are au futur ?",
      "verso": "Il devient -e- : parlare → parlerò."
    },
    {
      "recto": "Futur des verbes en -care / -gare ?",
      "verso": "On ajoute un h : cercare → cercherò, pagare → pagherò."
    },
    {
      "recto": "Futur des verbes en -ciare / -giare ?",
      "verso": "On perd le -i- : cominciare → comincerò, mangiare → mangerò."
    },
    {
      "recto": "Futur de essere et avere (io) ?",
      "verso": "sarò et avrò."
    },
    {
      "recto": "Futur de fare et andare (io) ?",
      "verso": "farò et andrò."
    },
    {
      "recto": "Futur de venire et volere (io) ?",
      "verso": "verrò et vorrò (deux r)."
    },
    {
      "recto": "Futur de dovere et potere (io) ?",
      "verso": "dovrò et potrò."
    },
    {
      "recto": "Traduis « Domani sarò a casa ».",
      "verso": "Demain je serai à la maison."
    },
    {
      "recto": "Erreur fréquente avec les verbes en -are ?",
      "verso": "❌ parlarò → ✅ parlerò."
    },
    {
      "recto": "Combien de r pour verrò et vorrò ?",
      "verso": "Deux r : ce sont des irréguliers à double consonne."
    }
  ]
}
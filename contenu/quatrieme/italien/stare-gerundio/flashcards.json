  "cartes": [
    {
      "recto": "À quoi sert « stare + gérondif » ?",
      "verso": "À exprimer une action en train de se dérouler : Sto mangiando = je suis en train de manger."
    },
    {
      "recto": "Conjugaison de stare au présent ?",
      "verso": "sto, stai, sta, stiamo, state, stanno."
    },
    {
      "recto": "Gérondif des verbes en -are ?",
      "verso": "-ando : parlare → parlando."
    },
    {
      "recto": "Gérondif des verbes en -ere ?",
      "verso": "-endo : scrivere → scrivendo."
    },
    {
      "recto": "Gérondif des verbes en -ire ?",
      "verso": "-endo : dormire → dormendo."
    },
    {
      "recto": "Gérondif de fare ?",
      "verso": "facendo (irrégulier)."
    },
    {
      "recto": "Gérondif de dire ?",
      "verso": "dicendo (irrégulier)."
    },
    {
      "recto": "Gérondif de bere ?",
      "verso": "bevendo (irrégulier)."
    },
    {
      "recto": "Comment dire une action en cours dans le passé ?",
      "verso": "Stare à l'imperfetto + gérondif : Stavo dormendo."
    },
    {
      "recto": "Traduis « Stiamo guardando la TV ».",
      "verso": "Nous sommes en train de regarder la télé."
    },
    {
      "recto": "Quel auxiliaire pour le gérondif ?",
      "verso": "stare, jamais essere : ✅ sto mangiando, ❌ sono mangiando."
    },
    {
      "recto": "Gérondif ou participe présent ?",
      "verso": "On dit sto studiando (gérondif), pas sto studiante."
    }
  ]
}
  "statut": "brouillon",
  "relu_par": null,
  "consigne": "Cherche chaque exercice au brouillon avant d'ouvrir le corrigé.",
  "exercices": [
    {
      "id": 1,
      "difficulte": "decouverte",
      "notion": "formation",
      "enonce": "Conjugue « parlare » à l'imperfetto (io, tu, lui).",
      "corrige": [
        "Radical parl- + terminaisons -avo/-avi/-ava."
      ],
      "reponse": "parlavo, parlavi, parlava"
    },
    {
      "id": 2,
      "difficulte": "decouverte",
      "notion": "formation",
      "enonce": "Mets à l'imperfetto : Noi (credere).",
      "corrige": [
        "Radical cred- + -evamo."
      ],
      "reponse": "credevamo"
    },
    {
      "id": 3,
      "difficulte": "application",
      "notion": "irregolare",
      "enonce": "Conjugue « essere » à l'imperfetto (io, noi, loro).",
      "corrige": [
        "Essere est irrégulier : ero, eravamo, erano."
      ],
      "reponse": "ero, eravamo, erano"
    },
    {
      "id": 4,
      "difficulte": "application",
      "notion": "irregolare",
      "enonce": "Mets à l'imperfetto : Tu (fare) e io (dire).",
      "corrige": [
        "Fare → facev-, dire → dicev-.",
        "2e pers. facevi ; 1re pers. dicevo."
      ],
      "reponse": "Tu facevi e io dicevo."
    },
    {
      "id": 5,
      "difficulte": "application",
      "notion": "formation",
      "enonce": "Mets à l'imperfetto : Voi (dormire) sempre poco.",
      "corrige": [
        "Radical dorm- + -ivate."
      ],
      "reponse": "Voi dormivate sempre poco."
    },
    {
      "id": 6,
      "difficulte": "application",
      "notion": "emploi",
      "enonce": "Décris au passé : Ieri (fare) bel tempo.",
      "corrige": [
        "Description du décor → imperfetto : faceva."
      ],
      "reponse": "Ieri faceva bel tempo."
    },
    {
      "id": 7,
      "difficulte": "approfondissement",
      "notion": "emploi",
      "enonce": "Relie deux actions simultanées : Mentre io (leggere), lei (cucinare).",
      "corrige": [
        "Deux actions simultanées → imperfetto pour les deux."
      ],
      "reponse": "Mentre io leggevo, lei cucinava."
    },
    {
      "id": 8,
      "difficulte": "approfondissement",
      "notion": "irregolare",
      "enonce": "Mets à l'imperfetto : Da bambino io (bere) tanto latte.",
      "corrige": [
        "Bere → bevev-, 1re pers. bevevo."
      ],
      "reponse": "Da bambino io bevevo tanto latte."
    },
    {
      "id": 9,
      "difficulte": "approfondissement",
      "notion": "traduction",
      "enonce": "Traduis : Quand j'étais petit, j'habitais à Milan.",
      "corrige": [
        "Quand = quando ; étais = ero ; habitais = abitavo."
      ],
      "reponse": "Quando ero piccolo, abitavo a Milano."
    },
    {
      "id": 10,
      "difficulte": "approfondissement",
      "notion": "erreur",
      "enonce": "Corrige : Loro facevamo sempre rumore.",
      "corrige": [
        "Sujet loro (3e pers. pluriel) → facevano, pas facevamo."
      ],
      "reponse": "Loro facevano sempre rumore."
    }
  ]
}
  "cartes": [
    {
      "recto": "À quoi sert l'imperfetto ?",
      "verso": "À décrire (décor, personnes), exprimer une habitude et des actions simultanées dans le passé."
    },
    {
      "recto": "Terminaisons de l'imperfetto pour -are ?",
      "verso": "-avo, -avi, -ava, -avamo, -avate, -avano."
    },
    {
      "recto": "Terminaisons de l'imperfetto pour -ere ?",
      "verso": "-evo, -evi, -eva, -evamo, -evate, -evano."
    },
    {
      "recto": "Terminaisons de l'imperfetto pour -ire ?",
      "verso": "-ivo, -ivi, -iva, -ivamo, -ivate, -ivano."
    },
    {
      "recto": "Imperfetto de essere ?",
      "verso": "ero, eri, era, eravamo, eravate, erano."
    },
    {
      "recto": "Imperfetto de fare (io) ?",
      "verso": "facevo (radical facev-)."
    },
    {
      "recto": "Imperfetto de dire (io) ?",
      "verso": "dicevo (radical dicev-)."
    },
    {
      "recto": "Imperfetto de bere (io) ?",
      "verso": "bevevo (radical bevev-)."
    },
    {
      "recto": "Comment traduire « Da bambino giocavo » ?",
      "verso": "Enfant, je jouais (habitude passée)."
    },
    {
      "recto": "Imperfetto ou passato prossimo pour décrire le décor ?",
      "verso": "L'imperfetto : Faceva freddo, pioveva."
    },
    {
      "recto": "Comment exprimer deux actions simultanées au passé ?",
      "verso": "Mentre + imperfetto : Mentre studiavo, ascoltavo la musica."
    },
    {
      "recto": "Erreur fréquente avec essere à l'imperfetto ?",
      "verso": "❌ essevo → ✅ ero."
    }
  ]
}
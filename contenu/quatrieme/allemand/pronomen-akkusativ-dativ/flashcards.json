  "cartes": [
    {
      "recto": "Accusatif de ich, du, er ?",
      "verso": "mich, dich, ihn."
    },
    {
      "recto": "Accusatif de sie (elle), es, sie (pluriel) ?",
      "verso": "sie, es, sie."
    },
    {
      "recto": "Accusatif de wir, ihr ?",
      "verso": "uns, euch."
    },
    {
      "recto": "Datif de ich, du, er ?",
      "verso": "mir, dir, ihm."
    },
    {
      "recto": "Datif de sie (elle), es ?",
      "verso": "ihr, ihm."
    },
    {
      "recto": "Datif de wir, ihr, sie (pluriel) ?",
      "verso": "uns, euch, ihnen."
    },
    {
      "recto": "Différence entre ihn et ihm ?",
      "verso": "ihn = accusatif de er (COD) ; ihm = datif de er (COI)."
    },
    {
      "recto": "Différence entre mich et mir ?",
      "verso": "mich = accusatif (Er sieht mich) ; mir = datif (Er hilft mir)."
    },
    {
      "recto": "Quel cas exige le verbe helfen ?",
      "verso": "Le datif : Ich helfe dir."
    },
    {
      "recto": "Quel cas exige le verbe sehen ?",
      "verso": "L'accusatif : Ich sehe dich."
    },
    {
      "recto": "Traduis : « Je lui écris. » (à elle)",
      "verso": "Ich schreibe ihr."
    },
    {
      "recto": "Traduis : « Je les aide. »",
      "verso": "Ich helfe ihnen (helfen + datif pluriel ihnen)."
    }
  ]
}
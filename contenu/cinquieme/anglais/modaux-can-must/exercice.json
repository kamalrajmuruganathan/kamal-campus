  "consigne": "Cherche chaque exercice au brouillon avant d'ouvrir le corrigé.",
  "exercices": [
    {
      "id": 1,
      "difficulte": "decouverte",
      "notion": "can",
      "enonce": "Complète avec can : I ___ ride a bike.",
      "corrige": [
        "« can » + base verbale, forme invariable.",
        "I **can** ride a bike."
      ],
      "reponse": "I can ride a bike."
    },
    {
      "id": 2,
      "difficulte": "decouverte",
      "notion": "must",
      "enonce": "Complète avec must : You ___ do your homework.",
      "corrige": [
        "« must » exprime l'obligation + base verbale.",
        "You **must** do your homework."
      ],
      "reponse": "You must do your homework."
    },
    {
      "id": 3,
      "difficulte": "application",
      "notion": "can-negation",
      "enonce": "Mets à la forme négative : She can drive.",
      "corrige": [
        "Négation de can → can't.",
        "She **can't** drive."
      ],
      "reponse": "She can't drive."
    },
    {
      "id": 4,
      "difficulte": "application",
      "notion": "can-question",
      "enonce": "Transforme en question : You can swim.",
      "corrige": [
        "On met « Can » avant le sujet.",
        "**Can you** swim?"
      ],
      "reponse": "Can you swim?"
    },
    {
      "id": 5,
      "difficulte": "application",
      "notion": "must-base",
      "enonce": "Corrige : You must to wear a helmet.",
      "corrige": [
        "Après un modal, pas de « to ».",
        "You **must wear** a helmet."
      ],
      "reponse": "You must wear a helmet."
    },
    {
      "id": 6,
      "difficulte": "application",
      "notion": "can-erreur",
      "enonce": "Corrige : He cans play football.",
      "corrige": [
        "« can » ne prend jamais de -s.",
        "He **can** play football."
      ],
      "reponse": "He can play football."
    },
    {
      "id": 7,
      "difficulte": "application",
      "notion": "traduction",
      "enonce": "Traduis : « Nous devons partir. »",
      "corrige": [
        "« devoir » (obligation) = must + base.",
        "We **must leave**."
      ],
      "reponse": "We must leave."
    },
    {
      "id": 8,
      "difficulte": "approfondissement",
      "notion": "mustnt",
      "enonce": "Exprime une interdiction : ne pas fumer ici.",
      "corrige": [
        "Interdiction → mustn't + base verbale.",
        "You **mustn't smoke** here."
      ],
      "reponse": "You mustn't smoke here."
    },
    {
      "id": 9,
      "difficulte": "approfondissement",
      "notion": "dont-have-to",
      "enonce": "Exprime : ce n'est pas obligatoire de venir.",
      "corrige": [
        "Pas obligatoire → don't have to.",
        "You **don't have to come**."
      ],
      "reponse": "You don't have to come."
    },
    {
      "id": 10,
      "difficulte": "approfondissement",
      "notion": "production",
      "enonce": "Écris deux phrases : une avec can, une avec must.",
      "corrige": [
        "can = capacité/permission ; must = obligation.",
        "Exemple : I **can** swim. I **must** study tonight."
      ],
      "reponse": "Exemple : I can swim. I must study tonight."
    }
  ]
}
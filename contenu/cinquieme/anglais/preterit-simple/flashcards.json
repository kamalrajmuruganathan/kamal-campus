  "cartes": [
    {
      "recto": "Comment forme-t-on le prétérit des verbes réguliers ?",
      "verso": "Base + -ed, identique à toutes les personnes : I **played**, she **watched**."
    },
    {
      "recto": "Prétérit de « study » ?",
      "verso": "studied (consonne + y : y → ied)."
    },
    {
      "recto": "Prétérit de « stop » ?",
      "verso": "stopped (on double la consonne finale)."
    },
    {
      "recto": "Prétérit irrégulier de « go » ?",
      "verso": "went : I **went** home."
    },
    {
      "recto": "Prétérit irrégulier de « see » ?",
      "verso": "saw : She **saw** a bird."
    },
    {
      "recto": "Prétérit irrégulier de « have » ?",
      "verso": "had : We **had** lunch."
    },
    {
      "recto": "Prétérit du verbe « be » ?",
      "verso": "was / were : I **was**, they **were**."
    },
    {
      "recto": "Comment fait-on la négation au prétérit ?",
      "verso": "didn't + base verbale : I **didn't play**."
    },
    {
      "recto": "Comment pose-t-on une question au prétérit ?",
      "verso": "Did + sujet + base verbale : **Did** you **play**?"
    },
    {
      "recto": "Que devient le verbe après « did / didn't » ?",
      "verso": "Il revient à la base : *didn't go*, jamais *didn't went*."
    },
    {
      "recto": "Négation de « be » au prétérit ?",
      "verso": "wasn't / weren't (sans did) : She **wasn't** here."
    },
    {
      "recto": "Quels mots indiquent le prétérit ?",
      "verso": "yesterday, last week, last year, two days ago, in 2010."
    }
  ]
}
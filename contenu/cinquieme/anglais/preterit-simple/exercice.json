  "titre": "Exercices — Le prétérit simple (verbes réguliers et irréguliers)",
  "voie": "college",
  "niveau": "cinquieme",
  "parcours": "anglais",
  "matiere": "anglais",
  "statut": "brouillon",
  "relu_par": null,
  "consigne": "Cherche chaque exercice au brouillon avant d'ouvrir le corrigé.",
  "exercices": [
    {
      "id": 1,
      "difficulte": "decouverte",
      "notion": "regulier",
      "enonce": "Mets au prétérit : I (to play) tennis yesterday.",
      "corrige": [
        "Verbe régulier : play + -ed.",
        "I **played** tennis yesterday."
      ],
      "reponse": "I played tennis yesterday."
    },
    {
      "id": 2,
      "difficulte": "decouverte",
      "notion": "regulier",
      "enonce": "Mets au prétérit : She (to watch) a film last night.",
      "corrige": [
        "watch + -ed = watched.",
        "She **watched** a film last night."
      ],
      "reponse": "She watched a film last night."
    },
    {
      "id": 3,
      "difficulte": "application",
      "notion": "orthographe",
      "enonce": "Écris le prétérit : study, stop, live, want.",
      "corrige": [
        "study → studied (y → ied).",
        "stop → stopped (consonne doublée).",
        "live → lived (juste -d). want → wanted."
      ],
      "reponse": "studied, stopped, lived, wanted"
    },
    {
      "id": 4,
      "difficulte": "application",
      "notion": "irregulier",
      "enonce": "Mets au prétérit : We (to go) to London.",
      "corrige": [
        "« go » est irrégulier → went.",
        "We **went** to London."
      ],
      "reponse": "We went to London."
    },
    {
      "id": 5,
      "difficulte": "application",
      "notion": "irregulier",
      "enonce": "Donne le prétérit de : see, have, take, eat.",
      "corrige": [
        "see → saw ; have → had.",
        "take → took ; eat → ate."
      ],
      "reponse": "saw, had, took, ate"
    },
    {
      "id": 6,
      "difficulte": "application",
      "notion": "negation",
      "enonce": "Mets à la forme négative : I played football.",
      "corrige": [
        "Prétérit négatif : didn't + base verbale.",
        "I **didn't play** football."
      ],
      "reponse": "I didn't play football."
    },
    {
      "id": 7,
      "difficulte": "application",
      "notion": "interrogation",
      "enonce": "Transforme en question : You saw the match.",
      "corrige": [
        "Did + sujet + base verbale.",
        "**Did you see** the match?"
      ],
      "reponse": "Did you see the match?"
    },
    {
      "id": 8,
      "difficulte": "application",
      "notion": "be",
      "enonce": "Complète avec was ou were : I ___ tired, they ___ happy.",
      "corrige": [
        "« I » → was ; « they » → were.",
        "I **was** tired, they **were** happy."
      ],
      "reponse": "I was tired, they were happy."
    },
    {
      "id": 9,
      "difficulte": "approfondissement",
      "notion": "erreur",
      "enonce": "Corrige : She didn't went to school.",
      "corrige": [
        "Après didn't, base verbale.",
        "She **didn't go** to school."
      ],
      "reponse": "She didn't go to school."
    },
    {
      "id": 10,
      "difficulte": "approfondissement",
      "notion": "production",
      "enonce": "Raconte au prétérit ce que tu as fait hier (deux phrases).",
      "corrige": [
        "Utilise -ed ou une forme irrégulière.",
        "Exemple : Yesterday I **went** to school and I **played** with my friends."
      ],
      "reponse": "Exemple : Yesterday I went to school and I played with my friends."
    }
  ]
}
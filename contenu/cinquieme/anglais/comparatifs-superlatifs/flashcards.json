  "cartes": [
    {
      "recto": "Comment forme-t-on le comparatif d'un adjectif court ?",
      "verso": "adjectif + -er + than : Tom is **taller than** Ben."
    },
    {
      "recto": "Comment forme-t-on le comparatif d'un adjectif long ?",
      "verso": "more + adjectif + than : more **interesting** than."
    },
    {
      "recto": "Comment forme-t-on le superlatif d'un adjectif court ?",
      "verso": "the + adjectif + -est : the **tallest**."
    },
    {
      "recto": "Comment forme-t-on le superlatif d'un adjectif long ?",
      "verso": "the most + adjectif : the **most expensive**."
    },
    {
      "recto": "Comparatif et superlatif de « good » ?",
      "verso": "better / the best (irrégulier)."
    },
    {
      "recto": "Comparatif et superlatif de « bad » ?",
      "verso": "worse / the worst (irrégulier)."
    },
    {
      "recto": "Orthographe : comparatif de « big » ?",
      "verso": "bigger (on double la consonne finale)."
    },
    {
      "recto": "Orthographe : comparatif de « easy » ?",
      "verso": "easier (consonne + y : y → ier)."
    },
    {
      "recto": "Peut-on dire « more bigger » ?",
      "verso": "Non : jamais more et -er ensemble. On dit **bigger**."
    },
    {
      "recto": "Quel petit mot suit toujours le comparatif ?",
      "verso": "than : taller **than**, more interesting **than**."
    },
    {
      "recto": "Quel petit mot précède toujours le superlatif ?",
      "verso": "the : **the** tallest, **the** most expensive."
    },
    {
      "recto": "Comment dit-on « aussi... que » ?",
      "verso": "as + adjectif + as : Anna is **as tall as** Tom."
    }
  ]
}
{
  "id": "5e-anglais-present-continu-cartes",
  "chapitre": "5e-anglais-present-continu",
  "titre": "Cartes — Le présent continu (be + -ing)",
  "voie": "college",
  "niveau": "cinquieme",
  "parcours": "anglais",
  "matiere": "anglais",
  "statut": "brouillon",
  "relu_par": null,
  "cartes": [
    {
      "recto": "Comment forme-t-on le présent continu ?",
      "verso": "Avec be (am/is/are) + verbe-ing : She **is playing**."
    },
    {
      "recto": "Quel auxiliaire avec « I » ?",
      "verso": "am : I **am** working."
    },
    {
      "recto": "Quel auxiliaire avec « he/she/it » ?",
      "verso": "is : She **is** reading."
    },
    {
      "recto": "Quel auxiliaire avec « you/we/they » ?",
      "verso": "are : They **are** eating."
    },
    {
      "recto": "Comment fait-on la négation au présent continu ?",
      "verso": "am/is/are + not : She **isn't** playing."
    },
    {
      "recto": "Comment pose-t-on une question au présent continu ?",
      "verso": "On inverse be et le sujet : **Are** you working?"
    },
    {
      "recto": "Forme en -ing de « write » ?",
      "verso": "writing (on enlève le -e muet)."
    },
    {
      "recto": "Forme en -ing de « run » ?",
      "verso": "running (on double la consonne finale)."
    },
    {
      "recto": "Forme en -ing de « lie » ?",
      "verso": "lying (-ie devient -y)."
    },
    {
      "recto": "Quand utilise-t-on le présent continu ?",
      "verso": "Pour une action en cours maintenant : *Look! It's raining.*"
    },
    {
      "recto": "Quels mots indiquent le présent continu ?",
      "verso": "now, at the moment, right now, Look!, Listen!"
    },
    {
      "recto": "Quels verbes ne se mettent pas en -ing ?",
      "verso": "Les verbes d'état : like, want, know, love, understand → *I know*, pas *I am knowing*."
    }
  ]
}
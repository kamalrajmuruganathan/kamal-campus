  "cartes": [
    {
      "recto": "Conjugue esse au présent.",
      "verso": "sum, es, est, sumus, estis, sunt."
    },
    {
      "recto": "Conjugue amare au présent.",
      "verso": "amo, amas, amat, amamus, amatis, amant."
    },
    {
      "recto": "« Je suis » en latin ?",
      "verso": "sum."
    },
    {
      "recto": "« Ils sont » en latin ?",
      "verso": "sunt."
    },
    {
      "recto": "« J'aime » en latin ?",
      "verso": "amo."
    },
    {
      "recto": "« Nous aimons » en latin ?",
      "verso": "amamus."
    },
    {
      "recto": "Terminaison de l'infinitif de la 1re conjugaison ?",
      "verso": "-are (amare, cantare, laudare)."
    },
    {
      "recto": "Que marque la terminaison -nt ?",
      "verso": "La 3e personne du pluriel (amant, sunt, cantant)."
    },
    {
      "recto": "Différence entre amat et amant ?",
      "verso": "amat = il aime (sing.) ; amant = ils aiment (plur.)."
    },
    {
      "recto": "Pourquoi pas de pronom sujet en latin ?",
      "verso": "La terminaison du verbe indique déjà la personne."
    },
    {
      "recto": "Radical de cantare ?",
      "verso": "canta- (on retire -re)."
    },
    {
      "recto": "« Vous êtes » en latin ?",
      "verso": "estis."
    }
  ]
}
    },
    {
      "recto": "Quels sont les six cas latins ?",
      "verso": "Nominatif, Vocatif, Accusatif, Génitif, Datif, Ablatif."
    },
    {
      "recto": "Quel cas pour le sujet ?",
      "verso": "Le nominatif."
    },
    {
      "recto": "Quel cas pour le COD ?",
      "verso": "L'accusatif (terminaison -m au singulier)."
    },
    {
      "recto": "Quel cas pour le complément du nom ?",
      "verso": "Le génitif."
    },
    {
      "recto": "Comment prononce-t-on « c » et « g » en latin restitué ?",
      "verso": "Toujours durs : [k] et [g]. Cicero = « Kikéro »."

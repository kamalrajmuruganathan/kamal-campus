{
  "id": "5e-math-puissances-cartes",
  "chapitre": "5e-math-puissances",
  "titre": "Cartes — Puissances : carré et cube",
  "voie": "college",
  "niveau": "cinquieme",
  "parcours": "maths",
  "matiere": "mathematiques",
  "statut": "brouillon",
  "relu_par": null,
  "cartes": [
    {
      "recto": "Dans $a^n$, comment s'appellent $a$ et $n$ ?",
      "verso": "$a$ est la base, $n$ est l'exposant (le nombre de facteurs)."
    },
    {
      "recto": "Que vaut $a^2$ ?",
      "verso": "$a^2 = a \\times a$."
    },
    {
      "recto": "Que vaut $a^3$ ?",
      "verso": "$a^3 = a \\times a \\times a$."
    },
    {
      "recto": "Combien vaut $10^3$ ?",
      "verso": "$1\\,000$."
    },
    {
      "recto": "Combien vaut $2^4$ ?",
      "verso": "$16$ (et non $2 \\times 4 = 8$)."
    },
    {
      "recto": "Quel est l'ordre des priorités avec des puissances ?",
      "verso": "Parenthèses, puis puissances, puis $\\times$ et $\\div$, puis $+$ et $-$."
    },
    {
      "recto": "Combien vaut $5 + 3^2$ ?",
      "verso": "$14$ : on calcule $3^2 = 9$ d'abord."
    },
    {
      "recto": "$a^2$ et $2a$ sont-ils la même chose ?",
      "verso": "Non : $a^2 = a \\times a$ tandis que $2a = a + a$."
    },
    {
      "recto": "$(3+4)^2$ est-il égal à $3^2 + 4^2$ ?",
      "verso": "Non : $(3+4)^2 = 49$ mais $3^2 + 4^2 = 25$."
    },
    {
      "recto": "Quelle est l'aire d'un carré de côté $c$ ?",
      "verso": "$c^2$."
    },
    {
      "recto": "Quelle unité pour une aire ? pour un volume ?",
      "verso": "$\\text{cm}^2$ pour une aire, $\\text{cm}^3$ pour un volume."
    },
    {
      "recto": "Combien vaut $10^5$ ?",
      "verso": "$100\\,000$ : le chiffre 1 suivi de 5 zeros."
    }
  ]
}

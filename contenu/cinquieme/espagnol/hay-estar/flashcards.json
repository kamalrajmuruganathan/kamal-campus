{
  "id": "5e-espagnol-hay-estar-cartes",
  "chapitre": "5e-espagnol-hay-estar",
  "titre": "Cartes — Hay, está et están",
  "voie": "college",
  "niveau": "cinquieme",
  "parcours": "espagnol",
  "matiere": "espagnol",
  "statut": "brouillon",
  "relu_par": null,
  "cartes": [
    {
      "recto": "Que signifie *hay* ?",
      "verso": "« Il y a » : existence. *Hay un libro.*"
    },
    {
      "recto": "*Hay* est-il variable ?",
      "verso": "Non, invariable : *Hay un libro / Hay dos libros.*"
    },
    {
      "recto": "Quand emploie-t-on *hay* ?",
      "verso": "Avec un mot indéfini : un, una, unos, dos, muchos…"
    },
    {
      "recto": "Quand emploie-t-on *está / están* ?",
      "verso": "Pour localiser un nom défini : el, la, mi, un nom propre."
    },
    {
      "recto": "Différence *está* / *están* ?",
      "verso": "*está* = 1 sujet ; *están* = plusieurs sujets."
    },
    {
      "recto": "Traduis : Le livre est sur la table.",
      "verso": "El libro **está** en la mesa."
    },
    {
      "recto": "Traduis : Les livres sont sur la table.",
      "verso": "Los libros **están** en la mesa."
    },
    {
      "recto": "Traduis : Il y a un livre sur la table.",
      "verso": "**Hay** un libro en la mesa."
    },
    {
      "recto": "Corrige : *Hay el gato en el jardín.*",
      "verso": "Faux → El gato **está** en el jardín."
    },
    {
      "recto": "Hay ou está ? *___ una farmacia cerca.*",
      "verso": "**Hay** (une pharmacie = indéfini)."
    },
    {
      "recto": "Hay ou está ? *La farmacia ___ cerca.*",
      "verso": "**está** (la pharmacie = défini)."
    },
    {
      "recto": "Traduis : Où sont mes chaussures ?",
      "verso": "¿Dónde **están** mis zapatos?"
    }
  ]
}
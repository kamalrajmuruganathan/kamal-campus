  "cartes": [
    {
      "recto": "À quoi servent les possessifs ?",
      "verso": "À exprimer l'appartenance : mein Buch (mon livre)."
    },
    {
      "recto": "Possessifs au singulier",
      "verso": "ich → mein, du → dein, er → sein, sie → ihr, es → sein."
    },
    {
      "recto": "Possessifs au pluriel",
      "verso": "wir → unser, ihr → euer, sie → ihr, Sie → Ihr."
    },
    {
      "recto": "Comment se déclinent les possessifs ?",
      "verso": "Comme ein et kein."
    },
    {
      "recto": "mein au nominatif",
      "verso": "mein (masc), meine (fém), mein (neutre), meine (pl)."
    },
    {
      "recto": "mein à l'accusatif",
      "verso": "meinen (masc), meine (fém), mein (neutre), meine (pl)."
    },
    {
      "recto": "Traduis : mon père (nominatif)",
      "verso": "mein Vater (der Vater)."
    },
    {
      "recto": "Traduis : ma mère",
      "verso": "meine Mutter (die Mutter)."
    },
    {
      "recto": "Traduis : J'aime mon chien.",
      "verso": "Ich liebe meinen Hund (masc. accusatif → meinen)."
    },
    {
      "recto": "Attention à euer",
      "verso": "Devant une terminaison, euer perd son 2e e : euer → eure Bücher."
    },
    {
      "recto": "sein ou ihr ?",
      "verso": "sein = son/sa (à lui) ; ihr = son/sa (à elle) ou leur."
    },
    {
      "recto": "Erreur à éviter",
      "verso": "Le possessif s'accorde avec le nom possédé, pas avec le possesseur : Anna liebt ihren Vater (der Vater masc acc → ihren)."
    }
  ]
}
{
  "name": "kamal-campus",
  "version": "0.1.0",
  "description": "Kamal Campus — fiches, QCM et outils de calcul pour le lycée (Maths & Physique-Chimie)",
  "private": true,
  "main": "index.js",
  "type": "module",
  "scripts": {
    "preparer": "node scripts/generer-index.mjs && node scripts/preparer-katex.mjs",
    "start": "npm run preparer && expo start",
    "android": "npm run preparer && expo start --android",
    "ios": "npm run preparer && expo start --ios",
    "test": "node --test lib/*.test.js lib/**/*.test.js",
    "qualite": "node scripts/verifier-qualite.mjs",
    "relecture": "node scripts/etat-relecture.mjs",
    "schemas": "node ../outils/generer-schemas.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@supabase/supabase-js": "^2.116.0",
    "@vscode/markdown-it-katex": "^1.1.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57",
    "expo-camera": "~57.0.4",
    "expo-notifications": "~57.0.17",
    "expo-sharing": "~57.0.18",
    "expo-speech": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "pdfjs-dist": "^6.2.108"
  },
  "license": "UNLICENSED"
}
